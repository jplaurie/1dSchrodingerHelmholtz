@article{caroli_diffusion_1979,
	title = {Diffusion in a bistable potential: {A} systematic {WKB} treatment},
	volume = {21},
	issn = {0022-4715, 1572-9613},
	shorttitle = {Diffusion in a bistable potential},
	url = {http://link.springer.com/article/10.1007/BF01009609},
	doi = {10.1007/BF01009609},
	abstract = {We study the distributionP of a single stochastic variable, the evolution of which is described by a Fokker-Planck equation with a first moment deriving from a bistable potential, in the limit of constant and small diffusion coefficient. A systematic WKB analysis of the lowest eigenmodes of the equivalent Schr{\"o}dinger-like equation yields the following results: the final approach to equilibrium is governed by the Kramers high-viscosity rate, which is shown to be exact in this limit; for intermediate times, we show that Suzuki's scaling statement does give the correct behavior for the transition between the one-peak and the two-peak structure forP. However, the intermediate time domain also contains a second {\textquotedblleft} half,{\textquotedblright} whereP enters the diffusive equilibrium regions, characterized by a time scale of the same order as Suzuki's time.},
	language = {en},
	number = {4},
	urldate = {2014-08-05},
	journal = {Journal of Statistical Physics},
	author = {Caroli, B. and Caroli, C. and Roulet, B.},
	month = oct,
	year = {1979},
	keywords = {Mathematical and Computational Physics, Quantum Physics, Statistical Physics, diffusion, Physical Chemistry, Instability, Nonlinear Fokker-Planck equation},
	pages = {415--437},
	file = {Caroli et al-1979-Diffusion in a bistable potential.pdf:/Users/lauriej/Box/Zotero_library/1979/Caroli et al-1979-Diffusion in a bistable potential.pdf:application/pdf;Snapshot:/Users/lauriej/Zotero/storage/Q7TH4QAZ/Caroli et al. - 1979 - Diffusion in a bistable potential\: A systematic WK.html:text/html}
}

@article{kozik_comment_2010,
	title = {Comment on {\textquotedblleft}{Symmetries} and {Interaction} {Coefficients} of {Kelvin} waves{\textquotedblright} by {Lebedev} and {L}{\textquoteright}vov},
	volume = {161},
	issn = {0022-2291, 1573-7357},
	url = {http://link.springer.com/article/10.1007/s10909-010-0242-z},
	doi = {10.1007/s10909-010-0242-z},
	abstract = {We comment on the claim by Lebedev and L{\textquoteright}vov (J. Low Temp. Phys. 161, 2010) that the symmetry with respect to a tilt of a quantized vortex line does not yet prohibit coupling between Kelvin waves and the large-scale slope of the line. Ironically, the counterexample of an effective scattering vertex in the local induction approximation (LIA) attempted by Lebedev and L{\textquoteright}vov invalidates their logic all by itself being a notoriously known example of how symmetries impose stringent constraints on kelvon kinetics{\textemdash}not only the coupling in question but the kinetics in general are absent within LIA. We further explain that the mistake arises from confusing symmetry properties of a specific mathematical representation in terms of the canonical vortex position field w(z)=x(z)+iy(z), which explicitly breaks the tilt symmetry due to an arbitrary choice of the z-axis, with those of the real physical system recovered in final expressions.},
	language = {en},
	number = {5-6},
	urldate = {2014-08-20},
	journal = {Journal of Low Temperature Physics},
	author = {Kozik, E. V. and Svistunov, B. V.},
	month = dec,
	year = {2010},
	pages = {603--605},
	file = {Kozik-Svistunov-2010-Comment on {\textquotedblleft}Symmetries and Interaction Coefficients of Kelvin waves{\textquotedblright} by Lebedev.pdf:/Users/lauriej/Box/Zotero_library/2010/Kozik-Svistunov-2010-Comment on {\textquotedblleft}Symmetries and Interaction Coefficients of Kelvin waves{\textquotedblright} by Lebedev.pdf:application/pdf}
}

@article{kozik_theory_2009,
	title = {Theory of {Decay} of {Superfluid} {Turbulence} in the {Low}-{Temperature} {Limit}},
	volume = {156},
	issn = {0022-2291, 1573-7357},
	url = {http://link.springer.com/article/10.1007/s10909-009-9914-y},
	doi = {10.1007/s10909-009-9914-y},
	abstract = {We review the theory of relaxational kinetics of superfluid turbulence{\textemdash}a tangle of quantized vortex lines{\textemdash}in the limit of very low temperatures when the motion of vortices is conservative. While certain important aspects of the decay kinetics depend on whether the tangle is non-structured, like the one corresponding to the Kibble-Zurek picture, or essentially polarized, like the one that emulates the Richardson-Kolmogorov regime of classical turbulence, there are common fundamental features. In both cases, there exists an asymptotic range in the wavenumber space where the energy flux is supported by the cascade of Kelvin waves (kelvons){\textemdash}precessing distortions propagating along the vortex filaments. At large enough wavenumbers, the Kelvin-wave cascade is supported by three-kelvon elastic scattering. At zero temperature, the dissipative cutoff of the Kelvin-wave cascade is due to the emission of phonons, in which an elementary process converts two kelvons with almost opposite momenta into one bulk phonon. Along with the standard set of conservation laws, a crucial role in the theory of low-temperature vortex dynamics is played by the fact of integrability of the local induction approximation (LIA) controlled by the parameter $\Lambda$=ln ($\lambda$/a 0), with $\lambda$ the characteristic kelvon wavelength and a 0 the vortex core radius. While excluding a straightforward onset of the pure three-kelvon cascade, the integrability of LIA does not plug the cascade because of the natural availability of the kinetic channels associated with vortex line reconnections. We argue that the crossover from Richardson-Kolmogorov to the Kelvin-wave cascade is due to eventual dominance of local induction of a single line over the collective induction of polarized eddies, which causes the breakdown of classical-fluid regime and gives rise to a reconnection-driven inertial range.},
	language = {en},
	number = {3-6},
	urldate = {2014-08-20},
	journal = {Journal of Low Temperature Physics},
	author = {Kozik, E. V. and Svistunov, B. V.},
	month = sep,
	year = {2009},
	keywords = {Vortex dynamics, Turbulence, Condensed Matter, Characterization and Evaluation of Materials, Magnetism, Magnetic Materials, Kelvin-wave cascade},
	pages = {215--267},
	file = {Kozik-Svistunov-2009-Theory of Decay of Superfluid Turbulence in the Low-Temperature Limit.pdf:/Users/lauriej/Box/Zotero_library/2009/Kozik-Svistunov-2009-Theory of Decay of Superfluid Turbulence in the Low-Temperature Limit.pdf:application/pdf;Snapshot:/Users/lauriej/Zotero/storage/XEUZAP4P/Kozik and Svistunov - 2009 - Theory of Decay of Superfluid Turbulence in the Lo.html:text/html}
}

@article{walmsley_quantum_2008,
	title = {Quantum and {Quasiclassical} {Types} of {Superfluid} {Turbulence}},
	volume = {100},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.100.245301},
	doi = {10.1103/PhysRevLett.100.245301},
	abstract = {By injecting negative ions in superfluid He4 in the zero-temperature limit (T<=0.5 K), we have generated tangles of quantized vortex line with negligible large-scale flow. For this quantum regime of superfluid turbulence, the vortex line length L was found to decay at late time t as L?t-1, the prefactor being independent of the initial value of L. The corresponding effective kinematic viscosity is 0.1 $\kappa$, where $\kappa$ is the circulation quantum. At T{\textgreater}0.7 K, a jet of ions generates quasiclassical tangles identical to those produced by mechanical means.},
	number = {24},
	urldate = {2014-08-20},
	journal = {Physical Review Letters},
	author = {Walmsley, P. M. and Golov, A. I.},
	month = jun,
	year = {2008},
	pages = {245301},
	file = {APS Snapshot:/Users/lauriej/Zotero/storage/V4R273JZ/Walmsley and Golov - 2008 - Quantum and Quasiclassical Types of Superfluid Tur.html:text/html;Walmsley-Golov-2008-Quantum and Quasiclassical Types of Superfluid Turbulence.pdf:/Users/lauriej/Box/Zotero_library/2008/Walmsley-Golov-2008-Quantum and Quasiclassical Types of Superfluid Turbulence.pdf:application/pdf}
}

@article{walmsley_dissipation_2007,
	title = {Dissipation of {Quantum} {Turbulence} in the {Zero} {Temperature} {Limit}},
	volume = {99},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.99.265302},
	doi = {10.1103/PhysRevLett.99.265302},
	abstract = {Turbulence, produced by an impulsive spin down from angular velocity $\Omega$ to rest of a cube-shaped container, is investigated in superfluid He4 at temperatures 0.08 K{\textendash}1.6 K. The density of quantized vortex lines L is measured by scattering negative ions. Homogeneous turbulence develops after time t?20/$\Omega$ and decays as L?t-3/2. The corresponding energy flux $\epsilon$=$\nu$'($\kappa$L)2?t-3 is characteristic of quasiclassical turbulence at high Re with a saturated energy-containing length. The effective kinematic viscosity in T=0 limit is $\nu$'=0.003$\kappa$, where $\kappa$=10-3 cm2 s-1 is the circulation quantum.},
	number = {26},
	urldate = {2014-08-20},
	journal = {Physical Review Letters},
	author = {Walmsley, P. M. and Golov, A. I. and Hall, H. E. and Levchenko, A. A. and Vinen, W. F.},
	month = dec,
	year = {2007},
	pages = {265302},
	file = {APS Snapshot:/Users/lauriej/Zotero/storage/BUXR2MUT/Walmsley et al. - 2007 - Dissipation of Quantum Turbulence in the Zero Temp.html:text/html;Walmsley et al-2007-Dissipation of Quantum Turbulence in the Zero Temperature Limit.pdf:/Users/lauriej/Box/Zotero_library/2007/Walmsley et al-2007-Dissipation of Quantum Turbulence in the Zero Temperature Limit.pdf:application/pdf}
}

@article{kozik_geometric_2010,
	title = {Geometric symmetries in superfluid vortex dynamics},
	volume = {82},
	url = {http://link.aps.org/doi/10.1103/PhysRevB.82.140510},
	doi = {10.1103/PhysRevB.82.140510},
	abstract = {Dynamics of quantized vortex lines in a superfluid feature symmetries associated with the geometric character of the complex-valued field, w(z)=x(z)+iy(z), describing the instant shape of the line. Along with a natural set of Noether{\textquoteright}s constants of motion, which{\textemdash}apart from their rather specific expressions in terms of w(z){\textemdash}are nothing but components of the total linear and angular momenta of the fluid, the geometric symmetry brings about crucial consequences for kinetics of distortion waves on the vortex lines, the Kelvin waves. It is the geometric symmetry that renders Kelvin-wave cascade local in the wave-number space. Similar considerations apply to other systems with purely geometric degrees of freedom.},
	number = {14},
	urldate = {2014-08-20},
	journal = {Physical Review B},
	author = {Kozik, Evgeny and Svistunov, Boris},
	month = oct,
	year = {2010},
	pages = {140510},
	file = {Kozik-Svistunov-2010-Geometric symmetries in superfluid vortex dynamics.pdf:/Users/lauriej/Box/Zotero_library/2010/Kozik-Svistunov-2010-Geometric symmetries in superfluid vortex dynamics.pdf:application/pdf}
}

@article{kozik_scanning_2008,
	title = {Scanning {Superfluid}-{Turbulence} {Cascade} by its {Low}-{Temperature} {Cutoff}},
	volume = {100},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.100.195302},
	doi = {10.1103/PhysRevLett.100.195302},
	abstract = {On the basis of a recently proposed scenario of the transformation of the Kolmogorov cascade into the Kelvin-wave cascade, we develop a theory of low-temperature cutoff. The theory predicts a specific behavior of the quantized vortex line density, L, controlled by the frictional coefficient, $\alpha$(T)<<1, responsible for the cutoff. The curve ln L(ln$\alpha$) is found to directly reflect the structure of the cascade, revealing four qualitatively distinct wave number regions. Excellent agreement with a recent experiment by Walmsley et al. [Phys. Rev. Lett. 99, 265302 (2007)]{\textemdash}in which L(T) has been measured down to T\~{}0.08 K{\textemdash}implies that the scenario of low-temperature superfluid turbulence is now experimentally validated and allows to quantify the Kelvin-wave cascade spectrum.},
	number = {19},
	urldate = {2014-08-20},
	journal = {Physical Review Letters},
	author = {Kozik, Evgeny and Svistunov, Boris},
	month = may,
	year = {2008},
	pages = {195302},
	file = {APS Snapshot:/Users/lauriej/Zotero/storage/ZEEK2ZWQ/Kozik and Svistunov - 2008 - Scanning Superfluid-Turbulence Cascade by its Low-.html:text/html;Kozik-Svistunov-2008-Scanning Superfluid-Turbulence Cascade by its Low-Temperature Cutoff.pdf:/Users/lauriej/Box/Zotero_library/2008/Kozik-Svistunov-2008-Scanning Superfluid-Turbulence Cascade by its Low-Temperature Cutoff.pdf:application/pdf}
}

@article{kozik_vortex-phonon_2005,
	title = {Vortex-phonon interaction},
	volume = {72},
	url = {http://link.aps.org/doi/10.1103/PhysRevB.72.172505},
	doi = {10.1103/PhysRevB.72.172505},
	abstract = {Kelvin waves{\textemdash}helical waves on quantized vortex lines{\textemdash}are the normal modes of vortices in a superfluid. At zero temperature, the only dissipative channel of vortex dynamics is phonon emission. Starting with the hydrodynamic action, we derive the Hamiltonian of vortex-phonon interaction, thereby reducing the problem of the interaction of Kelvin waves with sound to inelastic elementary excitation scattering. On the basis of this formalism, we calculate the rate of sound radiation by superfluid turbulence at zero temperature and estimate the value of short-wavelength cutoff of the turbulence spectrum.},
	number = {17},
	urldate = {2014-08-20},
	journal = {Physical Review B},
	author = {Kozik, Evgeny and Svistunov, Boris},
	month = nov,
