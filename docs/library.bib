@article{esler_universal_2015,
	title = {Universal statistics of point vortex turbulence},
	volume = {779},
	issn = {0022-1120, 1469-7645},
	url = {https://www.cambridge.org/core/journals/journal-of-fluid-mechanics/article/universal-statistics-of-point-vortex-turbulence/AA28F4B8D66EB10D57EA199BCF313B72},
	doi = {10.1017/jfm.2015.410},
	abstract = {A new methodology, based on the central limit theorem, is applied to describe the statistical mechanics of two-dimensional point vortex motion in a bounded container 


\${\textbackslash}mathscr\{D\}\$

, as the number of vortices 


\$N\$

 tends to infinity. The key to the approach is the identification of the normal modes of the system with the eigenfunction solutions of the so-called hydrodynamic eigenvalue problem of the Laplacian in 


\${\textbackslash}mathscr\{D\}\$

. The statistics of the projection of the vorticity distribution onto these eigenfunctions ({\textquoteleft}vorticity projections{\textquoteright}) are then investigated. The statistics are used first to obtain the density-of-states function and caloric curve for the system, generalising previous results to arbitrary (neutral) distributions of vortex circulations. Explicit expressions are then obtained for the microcanonical (i.e.~fixed energy) probability density functions of the vorticity projections in a form that can be compared directly with direct numerical simulations of the dynamics. The energy spectra of the resulting flows are predicted analytically. Ensembles of simulations with 


\$N=100\$

, in several conformal domains, are used to make a comprehensive validation of the theory, with good agreement found across a broad range of energies. The probability density function of the leading vorticity projection is of particular interest because it has a unimodal distribution at low energy and a bimodal distribution at high energy. This behaviour is indicative of a phase transition, known as Onsager{\textendash}Kraichnan condensation in the literature, between low-energy states with no mean flow in the domain and high-energy states with a coherent mean flow. The critical temperature for the phase transition, which depends on the shape but not the size of 


\${\textbackslash}mathscr\{D\}\$

, and the associated critical energy are found. Finally the accuracy and the extent of the validity of the theory, at finite 


\$N\$

, are explored using a Markov chain phase-space sampling method.},
	urldate = {2017-09-01},
	journal = {Journal of Fluid Mechanics},
	author = {Esler, J. G. and Ashbee, T. L.},
	month = sep,
	year = {2015},
	keywords = {mathematical foundations, turbulence theory, vortex dynamics},
	pages = {275--308},
	file = {Esler-Ashbee-2015-Universal statistics of point vortex turbulence.pdf:/Users/lauriej/Box/Zotero_library/2015/Esler-Ashbee-2015-Universal statistics of point vortex turbulence.pdf:application/pdf;Snapshot:/Users/lauriej/Zotero/storage/HHUAQKL3/AA28F4B8D66EB10D57EA199BCF313B72.html:text/html}
}

@article{ashbee_generalized_2013,
