	url = {http://www.sciencemag.org/content/333/6039/192},
	doi = {10.1126/science.1203223},
	abstract = {Shear flows undergo a sudden transition from laminar to turbulent motion as the velocity increases, and the onset of turbulence radically changes transport efficiency and mixing properties. Even for the well-studied case of pipe flow, it has not been possible to determine at what Reynolds number the motion will be either persistently turbulent or ultimately laminar. We show that in pipes, turbulence that is transient at low Reynolds numbers becomes sustained at a distinct critical point. Through extensive experiments and computer simulations, we were able to identify and characterize the processes ultimately responsible for sustaining turbulence. In contrast to the classical Landau-Ruelle-Takens view that turbulence arises from an increase in the temporal complexity of fluid motion, here, spatial proliferation of chaotic domains is the decisive process and intrinsic to the nature of fluid turbulence.},
	language = {en},
	number = {6039},
	urldate = {2014-07-20},
	journal = {Science},
	author = {Avila, Kerstin and Moxey, David and Lozar, Alberto de and Avila, Marc and Barkley, Dwight and Hof, Bj{\"o}rn},
	month = aug,
	year = {2011},
	pmid = {21737736},
	pages = {192--196},
	file = {Avila et al-2011-The Onset of Turbulence in Pipe Flow.pdf:/Users/lauriej/Box/Zotero_library/2011/Avila et al-2011-The Onset of Turbulence in Pipe Flow.pdf:application/pdf}
}

@article{xia_upscale_2011,
	title = {Upscale energy transfer in thick turbulent fluid layers},
	volume = {7},
	copyright = {{\textcopyright} 2011 Nature Publishing Group},
	issn = {1745-2473},
	url = {http://www.nature.com/nphys/journal/v7/n4/abs/nphys1910.html},
	doi = {10.1038/nphys1910},
	abstract = {Flows in natural fluid layers are often forced simultaneously at scales smaller and much larger than the depth. For example, the Earth{\textquoteright}s atmospheric flows are powered by gradients of solar heating: vertical gradients cause three-dimensional (3D) convection whereas horizontal gradients drive planetary scale flows. Nonlinear interactions spread energy over scales. The question is whether intermediate scales obtain their energy from a large-scale 2D flow or from a small-scale 3D turbulence. The paradox is that 2D flows do not transfer energy downscale whereas 3D turbulence does not support an upscale transfer. Here we demonstrate experimentally how a large-scale vortex and small-scale turbulence conspire to provide for an upscale energy cascade in thick layers. We show that a strong planar vortex suppresses vertical motions, thus facilitating an upscale energy cascade. In a bounded system, spectral condensation into a box-size vortex provides for a self-organized planar flow that secures an upscale energy transfer.},
	language = {en},
	number = {4},
	urldate = {2014-07-20},
	journal = {Nature Physics},
	author = {Xia, H. and Byrne, D. and Falkovich, G. and Shats, M.},
	month = apr,
	year = {2011},
	pages = {321--324},
	file = {Xia et al-2011-Upscale energy transfer in thick turbulent fluid layers.pdf:/Users/lauriej/Box/Zotero_library/2011/Xia et al-2011-Upscale energy transfer in thick turbulent fluid layers.pdf:application/pdf}
}

