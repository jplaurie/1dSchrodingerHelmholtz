@article{bouchet_random_2009,
	title = {Random {Changes} of {Flow} {Topology} in {Two}-{Dimensional} and {Geophysical} {Turbulence}},
	volume = {102},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.102.094504},
	doi = {10.1103/PhysRevLett.102.094504},
	abstract = {We study the two-dimensional (2D) stochastic Navier-Stokes (SNS) equations in the inertial limit of weak forcing and dissipation. The stationary measure is concentrated close to steady solutions of the 2D Euler equations. For such inertial flows, we prove that bifurcations in the flow topology occur either by changing the domain shape, the nonlinearity of the vorticity{\textendash}stream-function relation, or the energy. Associated with this, we observe bistable behavior in SNS with random changes from dipoles to unidirectional flows. The theoretical explanation being very general, we infer the existence of similar phenomena in experiments and in some regimes of geophysical flows.},
	number = {9},
	urldate = {2014-07-02},
	journal = {Physical Review Letters},
	author = {Bouchet, Freddy and Simonnet, Eric},
	month = mar,
	year = {2009},
