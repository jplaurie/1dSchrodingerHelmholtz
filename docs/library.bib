	url = {http://epubs.siam.org/doi/abs/10.1137/S1064827502410633},
	doi = {10.1137/S1064827502410633},
	abstract = {A modification of the exponential time-differencing fourth-order Runge--Kutta method for solving stiff nonlinear PDEs is presented that solves the problem of numerical instability in the scheme as proposed by Cox and Matthews and generalizes the method to nondiagonal operators. A comparison is made of the performance of this modified exponential time-differencing (ETD) scheme against the competing methods of implicit-explicit differencing, integrating factors, time-splitting, and Fornberg and Driscoll's "sliders" for the KdV, Kuramoto--Sivashinsky, Burgers, and Allen--Cahn equations in one space dimension. Implementation of the method is illustrated by short MATLAB programs for two of the equations. It is found that for these applications with fixed time steps, the modified ETD scheme is the best.,  A modification of the exponential time-differencing fourth-order Runge--Kutta method for solving stiff nonlinear PDEs is presented that solves the problem of numerical instability in the scheme as proposed by Cox and Matthews and generalizes the method to nondiagonal operators. A comparison is made of the performance of this modified exponential time-differencing (ETD) scheme against the competing methods of implicit-explicit differencing, integrating factors, time-splitting, and Fornberg and Driscoll's "sliders" for the KdV, Kuramoto--Sivashinsky, Burgers, and Allen--Cahn equations in one space dimension. Implementation of the method is illustrated by short MATLAB programs for two of the equations. It is found that for these applications with fixed time steps, the modified ETD scheme is the best.},
	number = {4},
	urldate = {2014-08-15},
	journal = {SIAM Journal on Scientific Computing},
	author = {Kassam, A. and Trefethen, L.},
	month = jan,
	year = {2005},
	pages = {1214--1233},
	file = {Kassam-Trefethen-2005-Fourth-Order Time-Stepping for Stiff PDEs.pdf:/Users/lauriej/Box/Zotero_library/2005/Kassam-Trefethen-2005-Fourth-Order Time-Stepping for Stiff PDEs.pdf:application/pdf}
