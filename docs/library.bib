	doi = {10.1016/j.ijsolstr.2010.07.009},
	abstract = {This work elaborates upon two robust models of gradient elasticity and gradient plasticity, and one gradient model of heat transfer, as originally advocated by the second author in the 1980{\textquoteright}s. The objective is, after recalling the links between these models and existing generalized continuum theories as developed in the 1960{\textquoteright}s and subsequently, to apply the same methodology to the case of diffusion with a view to establishing generalized transport equations. Aifantis double diffusivity and conductivity theory that provides generalized mass or heat transfer equations is compared to micromorphic-type hyper-temperature and micro-entropy proposals. The double temperature and the micromorphic thermal models are shown to lead to equations more general that Cattaneo{\textquoteright}s. The sign of the coefficient of the second time-derivative of temperature is found to differ according to both approaches. The double temperature model contains a fourth space derivative term not present in the micromorphic models. Such generalized equations can be useful, for example, in the interpretation of recent femtosecond laser experiments on metals.},
	number = {25},
	urldate = {2019-09-05},
	journal = {International Journal of Solids and Structures},
	author = {Forest, Samuel and Aifantis, Elias C.},
	month = dec,
	year = {2010},
	keywords = {Gradient plasticity, Cattaneo equation, Gradient theory, Hyperbolic heat equation, Micromorphic theory},
	pages = {3367--3376},
	file = {ScienceDirect Full Text PDF:/Users/lauriej/Zotero/storage/VYTBQFDL/Forest and Aifantis - 2010 - Some links between recent gradient thermo-elasto-p.pdf:application/pdf;ScienceDirect Snapshot:/Users/lauriej/Zotero/storage/ARZRRI7M/S0020768310002544.html:text/html}
}

@article{busse_sequence--bifurcations_2003,
