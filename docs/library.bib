	file = {Miller et al-1992-Statistical mechanics, Euler{\textquoteright}s equation, and Jupiter{\textquoteright}s Red Spot.pdf:/Users/lauriej/Box/Zotero_library/1992/Miller et al-1992-Statistical mechanics, Euler{\textquoteright}s equation, and Jupiter{\textquoteright}s Red Spot.pdf:application/pdf}
}

@article{woillez_theoretical_2017,
