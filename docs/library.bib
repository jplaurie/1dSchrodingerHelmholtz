	doi = {10.1103/PhysRevA.67.015601},
	abstract = {The decay of superfluid turbulence in the limit of low temperature is studied by numerical simulations of vortex ring collisions. In particular we excite Kelvin waves and study the loss of vortex line length due to Kelvin-wave radiation. Although the effect is small, the decay constant is not inconsistent with recent experiments on vortex lattices in dilute Bose-Einstein condensates, and on superfluid turbulence in helium at very low temperature. We also consider the character of the decay when both vortex reconnections and Kelvin-wave radiation are present.},
