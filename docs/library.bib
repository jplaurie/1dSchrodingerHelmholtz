@article{nazarenko_freely_2007,
	title = {Freely decaying {Turbulence} and {Bose}{\textendash}{Einstein} {Condensation} in {Gross}{\textendash}{Pitaevski} {Model}},
	volume = {146},
	issn = {0022-2291, 1573-7357},
	url = {http://link.springer.com/article/10.1007/s10909-006-9271-z},
	doi = {10.1007/s10909-006-9271-z},
	abstract = {We study turbulence and Bose{\textendash}Einstein condensation (BEC) within the two-dimensional Gross{\textendash}Pitaevski (GP) model. In the present work, we compute decaying GP turbulence in order to establish whether BEC can occur without forcing and if there is an intensity threshold for this process. We use the wavenumber{\textendash}frequency plots which allow us to clearly separate the condensate and the wave components and, therefore, to conclude if BEC is present. We observe that BEC in such a system happens even for very weakly nonlinear initial conditions without any visible threshold. BEC arises via a growing phase coherence due to anihilation of phase defects/vortices. We study this process by tracking of propagating vortex pairs. The pairs loose momentum by scattering the background sound, which results in gradual decrease of the distance between the vortices. Occasionally, vortex pairs collide with a third vortex thereby emitting sound, which can lead to more sudden shrinking of the pairs. After the vortex anihilation the pulse propagates further as a dark soliton, and it eventually bursts creating a shock.},
	language = {en},
	number = {1-2},
	urldate = {2014-07-27},
	journal = {Journal of Low Temperature Physics},
	author = {Nazarenko, Sergey and Onorato, Miguel},
	month = jan,
	year = {2007},
	pages = {31--46},
	file = {Nazarenko-Onorato-2007-Freely decaying Turbulence and Bose{\textendash}Einstein Condensation in Gross{\textendash}Pitaevski.pdf:/Users/lauriej/Box/Zotero_library/2007/Nazarenko-Onorato-2007-Freely decaying Turbulence and Bose{\textendash}Einstein Condensation in Gross{\textendash}Pitaevski.pdf:application/pdf}
}

@article{harper_quadratic_2013,
	title = {Quadratic invariants for discrete clusters of weakly interacting waves},
	volume = {46},
	issn = {1751-8121},
	url = {http://iopscience.iop.org/1751-8121/46/24/245501},
	doi = {10.1088/1751-8113/46/24/245501},
	abstract = {We consider discrete clusters of quasi-resonant triads arising from a Hamiltonian three-wave equation. A cluster consists of N modes forming a total of M connected triads. We investigate the problem of constructing a functionally independent set of quadratic constants of motion. We show that this problem is equivalent to an underlying basic linear problem, consisting of finding the null space of a rectangular M {\texttimes} N matrix with entries 1, -1 and 0. In particular, we prove that the number of independent quadratic invariants is equal to J = N - M* ? N - M, where M* is the number of linearly independent rows in Thus, the problem of finding all independent quadratic invariants is reduced to a linear algebra problem in the Hamiltonian case. We establish that the properties of the quadratic invariants (e.g., locality) are related to the topological properties of the clusters (e.g., types of linkage). To do so, we formulate an algorithm for decomposing large clusters into smaller ones and show how various invariants are related to certain parts of a cluster, including the basic structures leading to M* {\textless} M. We illustrate our findings by presenting examples from the Charney{\textendash}Hasegawa{\textendash}Mima wave model, and by showing a classification of small (up to three-triad) clusters.},
	language = {en},
	number = {24},
	urldate = {2014-07-27},
	journal = {Journal of Physics A: Mathematical and Theoretical},
	author = {Harper, Katie L. and Bustamante, Miguel D. and Nazarenko, Sergey V.},
	month = jun,
	year = {2013},
	pages = {245501},
	file = {Harper et al-2013-Quadratic invariants for discrete clusters of weakly interacting waves.pdf:/Users/lauriej/Box/Zotero_library/2013/Harper et al-2013-Quadratic invariants for discrete clusters of weakly interacting waves.pdf:application/pdf}
}

