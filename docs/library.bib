@article{lindborg_kinetic_2000,
	title = {The kinetic energy spectrum of the two-dimensional enstrophy turbulence cascade},
	volume = {12},
	issn = {1070-6631, 1089-7666},
	url = {http://scitation.aip.org/content/aip/journal/pof2/12/5/10.1063/1.870379},
	doi = {10.1063/1.870379},
	abstract = {A direct numerical simulation of forced two-dimensional turbulence with hyperviscosity is performed at resolution 4096 2 . A stage is reached at which the flux of enstrophy from large to small scales is approximately constant in time. The cubic and quintic relations for the third-order velocity structure function derived by Lindborg [J. Fluid Mech. 388, 259 (1999)] are verified. The calculated kinetic energy spectrum in the constant enstrophy flux range has the form E(k)= K $\varepsilon$ $\omega$ 2/3 k -3 , where $\varepsilon$ $\omega$ is the enstrophy dissipation. This is in accordance with the prediction of Kraichnan [Phys. Fluids 10, 1417 (1970)] and Batchelor [Phys. Fluids 12, II233 (1969)]. The logarithmic correction, suggested by Kraichnan [J. Fluid Mech. 47, 525 (1970)], is not present in the calculated spectrum.},
	number = {5},
	urldate = {2014-10-29},
	journal = {Physics of Fluids (1994-present)},
	author = {Lindborg, Erik and Alvelius, Krister},
	month = may,
	year = {2000},
	pages = {945--947},
	file = {Lindborg-Alvelius-2000-The kinetic energy spectrum of the two-dimensional enstrophy turbulence cascade.pdf:/Users/lauriej/Box/Zotero_library/2000/Lindborg-Alvelius-2000-The kinetic energy spectrum of the two-dimensional enstrophy turbulence cascade.pdf:application/pdf}
}

@article{chen_physical_2006,
	title = {Physical {Mechanism} of the {Two}-{Dimensional} {Inverse} {Energy} {Cascade}},
	volume = {96},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.96.084502},
	doi = {10.1103/PhysRevLett.96.084502},
	abstract = {We study the physical mechanisms of the two-dimensional inverse energy cascade using theory, numerics, and experiment. Kraichnan{\textquoteright}s prediction of a -5/3 spectrum with constant, negative energy flux is verified in our simulations of 2D Navier-Stokes equations. We observe a similar but shorter range of inverse cascade in laboratory experiments. Our theory predicts, and the data confirm, that inverse cascade results mainly from turbulent stress proportional to small-scale strain rotated by 45{\textdegree}. This {\textquotedblleft}skew-Newtonian{\textquotedblright} stress is explained by the elongation and thinning of small-scale vortices by large-scale strain which weakens their velocity and transfers their energy upscale.},
	number = {8},
	urldate = {2014-10-29},
	journal = {Physical Review Letters},
	author = {Chen, Shiyi and Ecke, Robert E. and Eyink, Gregory L. and Rivera, Michael and Wan, Minping and Xiao, Zuoli},
	month = feb,
	year = {2006},
	pages = {084502},
	file = {Chen et al-2006-Physical Mechanism of the Two-Dimensional Inverse Energy Cascade.pdf:/Users/lauriej/Box/Zotero_library/2006/Chen et al-2006-Physical Mechanism of the Two-Dimensional Inverse Energy Cascade.pdf:application/pdf}
}

@article{chen_physical_2003,
	title = {Physical {Mechanism} of the {Two}-{Dimensional} {Enstrophy} {Cascade}},
	volume = {91},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.91.214501},
	doi = {10.1103/PhysRevLett.91.214501},
	abstract = {In two-dimensional turbulence, irreversible forward transfer of enstrophy requires anticorrelation of the turbulent vorticity transport vector and the inertial-range vorticity gradient. We investigate the basic mechanism by numerical simulation of the forced Navier-Stokes equation. In particular, we obtain the probability distributions of the local enstrophy flux and of the alignment angle between vorticity gradient and transport vector. These are surprisingly symmetric and cannot be explained by a local eddy-viscosity approximation. The vorticity transport tends to be directed along streamlines of the flow and only weakly aligned down the fluctuating vorticity gradient. All these features are well explained by a local nonlinear model. The physical origin of the cascade lies in steepening of inertial-range vorticity gradients due to compression of vorticity level sets by the large-scale strain field.},
	number = {21},
	urldate = {2014-10-29},
	journal = {Physical Review Letters},
	author = {Chen, Shiyi and Ecke, Robert E. and Eyink, Gregory L. and Wang, Xin and Xiao, Zuoli},
	month = nov,
	year = {2003},
	pages = {214501},
	file = {Chen et al-2003-Physical Mechanism of the Two-Dimensional Enstrophy Cascade.pdf:/Users/lauriej/Box/Zotero_library/2003/Chen et al-2003-Physical Mechanism of the Two-Dimensional Enstrophy Cascade.pdf:application/pdf}
}

@article{tran_robustness_2004,
	title = {Robustness of the inverse cascade in two-dimensional turbulence},
	volume = {69},
	url = {http://link.aps.org/doi/10.1103/PhysRevE.69.036303},
	doi = {10.1103/PhysRevE.69.036303},
	abstract = {We study quasisteady inverse cascades in unbounded and bounded two-dimensional turbulence driven by time-independent injection and dissipated by molecular viscosity. It is shown that an inverse cascade that carries only a fraction r of the energy input to the largest scales requires the enstrophy-range energy spectrum to be steeper than k-5 (ruling out a direct cascade) unless 1-r<<1. A direct cascade requires the presence of an inverse cascade that carries virtually all energy to the largest scales (1-r<<1). These facts underlie the robustness of the Kolmogorov-Kraichnan k-5/3 inverse cascade, which is readily observable in numerical simulations without an accompanying direct enstrophy cascade. We numerically demonstrate an instance where the k-5/3 inverse-cascading range is realizable with 79\% of the energy injection dissipated within the energy range and virtually all of the enstrophy dissipated in the vicinity of the forcing region. As equilibrium is approached, the respective logarithmic slopes -$\alpha$ and -$\beta$ of the ranges of wave numbers lower and higher than the forcing wave number satisfy $\alpha$+$\beta$?8. These results are consistent with recent theoretical predictions.},
	number = {3},
	urldate = {2014-10-29},
	journal = {Physical Review E},
	author = {Tran, Chuong V. and Bowman, John C.},
	month = mar,
	year = {2004},
	pages = {036303},
	file = {Tran-Bowman-2004-Robustness of the inverse cascade in two-dimensional turbulence.pdf:/Users/lauriej/Box/Zotero_library/2004/Tran-Bowman-2004-Robustness of the inverse cascade in two-dimensional turbulence.pdf:application/pdf}
}

@article{borue_inverse_1994,
