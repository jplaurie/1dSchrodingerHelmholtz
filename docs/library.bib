@article{shats_spectral_2005,
	title = {Spectral condensation of turbulence in plasmas and fluids and its role in low-to-high phase transitions in toroidal plasma},
	volume = {71},
	url = {http://link.aps.org/doi/10.1103/PhysRevE.71.046409},
	doi = {10.1103/PhysRevE.71.046409},
	abstract = {Transitions from turbulence to order are studied experimentally in thin fluid layers and in magnetically confined toroidal plasma. It is shown that turbulence self-organizes through the mechanism of spectral condensation in both systems. The spectral redistribution of the turbulent energy leads to the reduction in the turbulence level, generation of coherent flow, reduction in the particle diffusion, and increase in the system{\textquoteright}s energy. The higher-order state in the plasma is sustained via the nonlocal spectral coupling of the linearly unstable spectral range to the large-scale mean flow. Spectral condensation of turbulence is discussed in terms of its role in the low-to-high confinement transitions in toroidal plasma which show similarity with phase transitions.},
	number = {4},
	urldate = {2014-10-29},
	journal = {Physical Review E},
	author = {Shats, M. G. and Xia, H. and Punzmann, H.},
	month = apr,
