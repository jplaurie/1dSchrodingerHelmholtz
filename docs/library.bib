	file = {APS Snapshot:/Users/lauriej/Zotero/storage/LVZFCKZV/PhysRevLett.118.html:text/html;Randoux et al-2017-Optical Random Riemann Waves in Integrable Turbulence.pdf:/Users/lauriej/Box/Zotero_library/2017/Randoux et al-2017-Optical Random Riemann Waves in Integrable Turbulence.pdf:application/pdf}
}

@article{randoux_nonlinear_2016,
	series = {Dispersive {Hydrodynamics}},
	title = {Nonlinear random optical waves: {Integrable} turbulence, rogue waves and intermittency},
	volume = {333},
	issn = {0167-2789},
	shorttitle = {Nonlinear random optical waves},
	url = {http://www.sciencedirect.com/science/article/pii/S0167278916301506},
	doi = {10.1016/j.physd.2016.04.001},
	abstract = {We examine the general question of statistical changes experienced by ensembles of nonlinear random waves propagating in systems ruled by integrable equations. In our study that enters within the framework of integrable turbulence, we specifically focus on optical fiber systems accurately described by the integrable one-dimensional nonlinear Schr{\"o}dinger equation. We consider random complex fields having a Gaussian statistics and an infinite extension at initial stage. We use numerical simulations with periodic boundary conditions and optical fiber experiments to investigate spectral and statistical changes experienced by nonlinear waves in focusing and in defocusing propagation regimes. As a result of nonlinear propagation, the power spectrum of the random wave broadens and takes exponential wings both in focusing and in defocusing regimes. Heavy-tailed deviations from Gaussian statistics are observed in focusing regime while low-tailed deviations from Gaussian statistics are observed in defocusing regime. After some transient evolution, the wave system is found to exhibit a statistically stationary state in which neither the probability density function of the wave field nor the spectrum changes with the evolution variable. Separating fluctuations of small scale from fluctuations of large scale both in focusing and defocusing regimes, we reveal the phenomenon of intermittency; i.e., small scales are characterized by large heavy-tailed deviations from Gaussian statistics, while the large ones are almost Gaussian.},
	urldate = {2018-01-11},
	journal = {Physica D: Nonlinear Phenomena},
	author = {Randoux, St{\'e}phane and Walczak, Pierre and Onorato, Miguel and Suret, Pierre},
	month = oct,
	year = {2016},
	keywords = {Nonlinear Schr{\"o}dinger equation, Rogue waves, Integrable turbulence, Intermittency, Random waves, Statistics},
	pages = {323--335},
	file = {Randoux et al-2016-Nonlinear random optical waves.pdf:/Users/lauriej/Box/Zotero_library/2016/Randoux et al-2016-Nonlinear random optical waves.pdf:application/pdf;ScienceDirect Snapshot:/Users/lauriej/Zotero/storage/58BITTU5/S0167278916301506.html:text/html}
}

