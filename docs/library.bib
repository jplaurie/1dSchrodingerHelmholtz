@article{mai_neo_developing_2011,
	title = {Developing an {Interactive} {Multimedia}-mediated {Learning} {Environment} {Using} {Gagne}'s 9 {Events} of {Instruction} in a {Malaysian} {Classroom}},
	volume = {38},
	issn = {00921815},
	abstract = {In this research project, Gagne's nine instructional events were incorporated into the development of an interactive multimedia learning module which was then embedded into a student-centred learning learning environment to enhance the knowledge transfer and the student learning process. This interactive learning module was presented to students taking subjects taught in INTI International University, Malaysia. Students were given a pre- and post test to measure their learning outcomes, and a survey to assess their perceptions and feedback, and these are presented in this paper. Results showed that students reported positive feedback in their attention to the content, their learning experiences, interaction, and with the presentation of the content, all of which provided strong support for the use of Gagne's nine instructional events as an instructional framework for the development of an interactive learning module within a student-centred learning environment.},
	number = {4},
	journal = {International Journal of Instructional Media},
	author = {{Mai Neo} and {Tse-Kian Neo} and {Fui-Theng Leow}},
	month = dec,
	year = {2011},
	keywords = {CLASSROOM environment, EDUCATIONAL technology, Gagne's 9 Events of Instruction, HIGH technology \& education, INTERACTIVE learning, Interactive multimedia, INTI-International University, Malaysia, MULTIMEDIA systems, STUDENT-centered learning, Student-centred learning},
	pages = {379--389}
}

@book{smith_impact_1996,
	title = {Impact of {R}. {M}. {Gagne}'s {Work} on {Instructional} {Theory}},
	url = {https://eric.ed.gov/?id=ED397841},
	abstract = {Although Robert M. Gagne's work is often thought of as learning theory, his contributions can most appropriately be considered as an "instructional theory." This denotes an integrated set of principles based upon learning theory, other relevant theories, and sound replicable research, that permits one to predict the effects of specific instructional conditions on a learner's cognitive processing and the resulting learned capabilities. This paper discusses: (1) the status of instructional theory before Gagne, specifically, curriculum theory and applied learning theory; (2) precursors to instructional theory; (3) instructional theory contributions, including the development of the types of learning, the learning hierarchies concept, events of instruction, and conditions of  learning; (4) the relationship of Gagne's work to learning theory; (5) the influences of Gagne's theory on instructional design models; and (6) the influences of Gagne's theory on curriculum design. Gagne's process of developing, refining, and extending his theory over time based upon new research and theory distinguishes him among scholars in the fields of educational psychology and instructional theory. (Contains 93 references.) (SWC)},
	language = {en},
	urldate = {2018-09-17},
	author = {Smith, Patricia L. and Ragan, Tillman J.},
	year = {1996},
	keywords = {Adoption (Ideas), Cognitive Processes, Curriculum Design, Instructional Design, Learning Processes, Learning Theories, Theory Practice Relationship},
	file = {Smith-Ragan-1996-Impact of R.pdf:/Users/lauriej/Box/Zotero_library/1996/Smith-Ragan-1996-Impact of R.pdf:application/pdf;Snapshot:/Users/lauriej/Zotero/storage/LNXT3M87/eric.ed.gov.html:text/html}
}

@inproceedings{slotta_blended_2008,
	address = {Utrecht, The Netherlands},
	series = {{ICLS}'08},
	title = {A {Blended} {Model} for {Knowledge} {Communities}: {Embedding} {Scaffolded} {Inquiry}},
	shorttitle = {A {Blended} {Model} for {Knowledge} {Communities}},
	url = {http://dl.acm.org/citation.cfm?id=1599871.1599914},
	abstract = {This study investigates a new approach that connects scaffolded inquiry activities within a knowledge building curriculum in secondary school science. We present a blended model that accounts for the flow of ideas within such a curriculum. Using a co-design methodology, researchers collaborated with veteran secondary science teachers to create engaging curriculum that provided the context for two studies. Study 1 created a four-day biology lesson where 104 grade-ten students developed a knowledge base of ideas about human physiology, then connected those ideas to inquiry activities. Students and teachers succeeded in collaborative knowledge construction, and individual students demonstrated impressive learning gains. Study 2 extended these principles to create an eight-week curriculum unit on biodiversity. This study replicated the co-design process, resulting in a successful curriculum, and further refined our technology environment. The outcomes of this work offer promising evidence for a blended model where knowledge building intersects with scaffolded inquiry.},
	urldate = {2018-09-17},
	booktitle = {Proceedings of the 8th {International} {Conference} on {International} {Conference} for the {Learning} {Sciences} - {Volume} 2},
	publisher = {International Society of the Learning Sciences},
	author = {Slotta, Jim and Peters, Vanessa},
	year = {2008},
	pages = {343--350},
	file = {Slotta-Peters-2008-A Blended Model for Knowledge Communities.pdf:/Users/lauriej/Box/Zotero_library/2008/Slotta-Peters-2008-A Blended Model for Knowledge Communities.pdf:application/pdf}
}

@article{banados_blended-learning_2006,
	title = {A {Blended}-learning {Pedagogical} {Model} for {Teaching} and {Learning} {EFL} {Successfully} {Through} an {Online} {Interactive} {Multimedia} {Environment}},
	volume = {23},
	issn = {0742-7778},
	url = {https://www.jstor.org/stable/24156354},
	abstract = {Faced with the need to teach English to a large number of students, the Universidad de Concepci{\'o}n, Chile, has created an innovative Communicative English Program using ICT, which is made up of four modules covered in four academic terms. The English program aims to develop integrated linguistic skills with a focus on learning for authentic communication. The program has been implemented in a blended-learning (b-learning) pedagogical model that includes: (a) learners' work with UdeC English Online, software conceived as the backbone of the entire Communicative English Program, (b) online monitoring, (c) face-to-face EFL teacher-led classes, and (d) conversation classes with native speakers of English. The online software is an interactive multimedia environment which houses all the materials and ICT tools that learners need in one central web platform. Some of the core concepts underlying its design are multimodal L2 input exposure, enhanced input, learner-fit content delivery, interaction (human-computer, human-human, and intrapersonal) through computer supported collaborative and individual learning tasks, as well as a more human-like dimension for positive and corrective feedback. This paper describes the elements of the b-learning model, issues about its implementation, and results obtained in the piloting of its first module.},
	number = {3},
	urldate = {2018-09-17},
	journal = {CALICO Journal},
	author = {Ba{\~n}ados, Emerita},
	year = {2006},
	pages = {533--550}
}

