	issn = {1916-9221},
	shorttitle = {The {Use} of {Autoethnography} in {Educational} {Research}},
	url = {https://journalhosting.ucalgary.ca/index.php/cjnse/article/view/30477},
	abstract = {Autoethnography is a research method that engages the individual in cultural analysis and interpretation (Chang, 2008).  The resultant self-analysis can have purposeful implications for the preparation of teachers and schools leaders.  The process of self-exploration and interrogation aids individuals in locating themselves within their own history and culture allowing them to broaden their understanding of their own values in relation to others.  In this paper, the methodological implications of autoethnography as well as its value as a research method is discussed in the context of understanding the self/other dialectic.  Further, the relationship between autoethnography and the philosophical and practical implications relating to identity within education is examined.},
	language = {en},
	number = {1},
