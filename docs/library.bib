}

@article{xia_turbulence-condensate_2008,
	title = {Turbulence-{Condensate} {Interaction} in {Two} {Dimensions}},
	volume = {101},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.101.194504},
	doi = {10.1103/PhysRevLett.101.194504},
	abstract = {We present experimental results on turbulence generated in thin fluid layers in the presence of a large-scale coherent flow, or a spectral condensate. It is shown that the condensate modifies the third-order velocity moment in a much wider interval of scales than the second one. The modification may include the change of sign of the third moment in the inverse cascade. This observation may help resolve a controversy on the energy flux in mesoscale atmospheric turbulence (10{\textendash}500 km): to recover a correct energy flux from the third velocity moment one needs first to subtract the coherent flow. We find that the condensate also increases the velocity flatness.},
	number = {19},
	urldate = {2014-07-04},
	journal = {Physical Review Letters},
	author = {Xia, H. and Punzmann, H. and Falkovich, G. and Shats, M. G.},
	month = nov,
	year = {2008},
	pages = {194504},
	file = {APS Snapshot:/Users/lauriej/Zotero/storage/4DSRF3ND/Xia et al. - 2008 - Turbulence-Condensate Interaction in Two Dimension.html:text/html;Xia et al-2008-Turbulence-Condensate Interaction in Two Dimensions.pdf:/Users/lauriej/Box/Zotero_library/2008/Xia et al-2008-Turbulence-Condensate Interaction in Two Dimensions.pdf:application/pdf}
}

@article{gallay_global_2005,
	title = {Global {Stability} of {Vortex} {Solutions} of the {Two}-{Dimensional} {Navier}-{Stokes} {Equation}},
	volume = {255},
	issn = {0010-3616, 1432-0916},
	url = {http://link.springer.com/article/10.1007/s00220-004-1254-9},
	doi = {10.1007/s00220-004-1254-9},
	abstract = {Both experimental and numerical studies of fluid motion indicate that initially localized regions of vorticity tend to evolve into isolated vortices and that these vortices then serve as organizing centers for the flow. In this paper we prove that in two dimensions localized regions of vorticity do evolve toward a vortex. More precisely we prove that any solution of the two-dimensional Navier-Stokes equation whose initial vorticity distribution is integrable converges to an explicit self-similar solution called {\textquotedblleft}Oseen{\textquoteright}s vortex{\textquotedblright}. This implies that the Oseen vortices are dynamically stable for all values of the circulation Reynolds number, and our approach also shows that these vortices are the only solutions of the two-dimensional Navier-Stokes equation with a Dirac mass as initial vorticity. Finally, under slightly stronger assumptions on the vorticity distribution, we give precise estimates on the rate of convergence toward the vortex.},
	language = {en},
	number = {1},
	urldate = {2014-07-04},
	journal = {Communications in Mathematical Physics},
	author = {Gallay, Thierry and Wayne, C. Eugene},
	month = apr,
	year = {2005},
	keywords = {Mathematical and Computational Physics, Nonlinear Dynamics, Complex Systems, Chaos, Neural Networks, Quantum Computing, Information and Physics, Quantum Physics, Relativity and Cosmology, Statistical Physics},
	pages = {97--129},
	file = {Gallay-Wayne-2005-Global Stability of Vortex Solutions of the Two-Dimensional Navier-Stokes.pdf:/Users/lauriej/Box/Zotero_library/2005/Gallay-Wayne-2005-Global Stability of Vortex Solutions of the Two-Dimensional Navier-Stokes.pdf:application/pdf;Snapshot:/Users/lauriej/Zotero/storage/56XRUMT6/Gallay and Wayne - 2005 - Global Stability of Vortex Solutions of the Two-Di.html:text/html}
}

@article{frisch_turbulence_2012,
	title = {Turbulence in {Noninteger} {Dimensions} by {Fractal} {Fourier} {Decimation}},
	volume = {108},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.108.074501},
	doi = {10.1103/PhysRevLett.108.074501},
	abstract = {Fractal decimation reduces the effective dimensionality D of a flow by keeping only a (randomly chosen) set of Fourier modes whose number in a ball of radius k is proportional to kD for large k. At the critical dimension Dc=4/3 there is an equilibrium Gibbs state with a k-5/3 spectrum, as in V. L{\textquoteright}vov et al., Phys. Rev. Lett. 89, 064501 (2002). Spectral simulations of fractally decimated two-dimensional turbulence show that the inverse cascade persists below D=2 with a rapidly rising Kolmogorov constant, likely to diverge as (D-4/3)-2/3.},
	number = {7},
	urldate = {2014-07-03},
	journal = {Physical Review Letters},
	author = {Frisch, Uriel and Pomyalov, Anna and Procaccia, Itamar and Ray, Samriddhi Sankar},
	month = feb,
