	author = {Rousset, B. and Bonnay, P. and Diribarne, P. and Girard, A. and Poncet, J. M. and Herbert, E. and Salort, J. and Baudet, C. and Castaing, B. and Chevillard, L. and Daviaud, F. and Dubrulle, B. and Gagne, Y. and Gibert, M. and H{\'e}bral, B. and Lehner, Th and Roche, P.-E. and Saint-Michel, B. and Mardion, M. Bon},
	month = oct,
	year = {2014},
	pages = {103908},
	file = {Rousset et al-2014-Superfluid high REynolds von K{\'a}rm{\'a}n experiment.pdf:/Users/lauriej/Box/Zotero_library/2014/Rousset et al-2014-Superfluid high REynolds von K{\'a}rm{\'a}n experiment.pdf:application/pdf}
}

