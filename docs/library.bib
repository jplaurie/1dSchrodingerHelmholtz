	file = {Woillez and Bouchet - 2019 - Barotropic theory for the velocity profile of Jupi.pdf:/Users/lauriej/Zotero/storage/C6PG3AHK/Woillez and Bouchet - 2019 - Barotropic theory for the velocity profile of Jupi.pdf:application/pdf}
