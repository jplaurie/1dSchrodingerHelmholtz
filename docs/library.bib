}

@article{sugiyama_flow_2010,
	title = {Flow {Reversals} in {Thermally} {Driven} {Turbulence}},
	volume = {105},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.105.034503},
	doi = {10.1103/PhysRevLett.105.034503},
	abstract = {We analyze the reversals of the large-scale flow in Rayleigh-B{\'e}nard convection both through particle image velocimetry flow visualization and direct numerical simulations of the underlying Boussinesq equations in a (quasi-) two-dimensional, rectangular geometry of aspect ratio 1. For medium Prandtl number there is a diagonal large-scale convection roll and two smaller secondary rolls in the two remaining corners diagonally opposing each other. These corner-flow rolls play a crucial role for the large-scale wind reversal: They grow in kinetic energy and thus also in size thanks to plume detachments from the boundary layers up to the time that they take over the main, large-scale diagonal flow, thus leading to reversal. The Rayleigh vs Prandtl number space is mapped out. The occurrence of reversals sensitively depends on these parameters.},
	number = {3},
	urldate = {2014-07-02},
	journal = {Physical Review Letters},
	author = {Sugiyama, Kazuyasu and Ni, Rui and Stevens, Richard J. A. M. and Chan, Tak Shing and Zhou, Sheng-Qi and Xi, Heng-Dong and Sun, Chao and Grossmann, Siegfried and Xia, Ke-Qing and Lohse, Detlef},
	month = jul,
	year = {2010},
	pages = {034503},
	file = {APS Snapshot:/Users/lauriej/Zotero/storage/F98EFCMV/PhysRevLett.105.html:text/html;Sugiyama et al-2010-Flow Reversals in Thermally Driven Turbulence.pdf:/Users/lauriej/Box/Zotero_library/2010/Sugiyama et al-2010-Flow Reversals in Thermally Driven Turbulence.pdf:application/pdf}
}

@article{schmeits_bimodal_2001,
	title = {Bimodal {Behavior} of the {Kuroshio} and the {Gulf} {Stream}},
	volume = {31},
	issn = {0022-3670},
	url = {http://journals.ametsoc.org/doi/full/10.1175/1520-0485(2001)031%3C3435%3ABBOTKA%3E2.0.CO%3B2},
	doi = {10.1175/1520-0485(2001)031<3435:BBOTKA>2.0.CO;2},
	abstract = {Abstract For a long time, observations have indicated that the Kuroshio in the North Pacific Ocean displays bimodal meandering behavior off the southern coast of Japan. For the Gulf Stream in the North Atlantic Ocean, weakly and strongly deflected paths near the coast of South Carolina have been observed. This suggests that bimodal behavior may occur in the Gulf Stream as well, although less pronounced than in the Kuroshio. Evidence from a high-resolution ocean general circulation model (OGCM) and intermediate complexity models is given to support the hypothesis that multiple mean paths of both the Kuroshio and the Gulf Stream are dynamically possible. These paths are found as multiple steady states in an intermediate complexity shallow-water model. In the OGCM, transitions between similar mean paths are found, with the patterns having similarity to the ones in observations as well. To study whether atmospheric noise can induce transitions between the multiple steady states, a stochastic component is added to the annual mean wind stress forcing in the intermediate complexity model and differences between the transition behavior in the Gulf Stream and Kuroshio are considered.},
	number = {12},
	urldate = {2014-07-02},
	journal = {Journal of Physical Oceanography},
	author = {Schmeits, Maurice J. and Dijkstra, Henk A.},
	month = dec,
	year = {2001},
	pages = {3435--3456},
	file = {Schmeits-Dijkstra-2001-Bimodal Behavior of the Kuroshio and the Gulf Stream.pdf:/Users/lauriej/Box/Zotero_library/2001/Schmeits-Dijkstra-2001-Bimodal Behavior of the Kuroshio and the Gulf Stream.pdf:application/pdf;Snapshot:/Users/lauriej/Zotero/storage/EJH3JC9C/1520-0485(2001)0313435BBOTKA2.0.html:text/html}
}

@article{ravelet_multistability_2004,
	title = {Multistability and {Memory} {Effect} in a {Highly} {Turbulent} {Flow}: {Experimental} {Evidence} for a {Global} {Bifurcation}},
	volume = {93},
	shorttitle = {Multistability and {Memory} {Effect} in a {Highly} {Turbulent} {Flow}},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.93.164501},
	doi = {10.1103/PhysRevLett.93.164501},
	abstract = {We report experimental evidence of a global bifurcation on a highly turbulent von K{\'a}rm{\'a}n flow. The mean flow presents multiple solutions: the canonical symmetric solution becomes marginally unstable towards a flow which breaks the basic symmetry of the driving apparatus even at very large Reynolds numbers. The global bifurcation between these states is highly subcritical and the system thus keeps a memory of its history. The transition recalls low-dimension dynamical system transitions and exhibits very peculiar statistics. We discuss the role of turbulence in two ways: the multiplicity of hydrodynamical solutions and the effect of fluctuations on the nature of transitions.},
	number = {16},
	urldate = {2014-07-02},
	journal = {Physical Review Letters},
	author = {Ravelet, Florent and Mari{\'e}, Louis and Chiffaudel, Arnaud and Daviaud, Fran{\c c}ois},
