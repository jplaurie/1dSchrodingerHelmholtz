@article{mcmanus_two_2001,
	title = {The {Two} {Paradigms} of {Education} and the {Peer} {Review} of {Teaching}},
	volume = {49},
	issn = {1089-9995},
	url = {https://doi.org/10.5408/1089-9995-49.5.423},
	doi = {10.5408/1089-9995-49.5.423},
	abstract = {Before a faculty member undergoes a peer review of teaching, both the reviewers and the faculty member should understand the two paradigms of education{\textendash}the Teaching-Centered Paradigm and the Learning-Centered Paradigm, because the paradigm chosen, even tacitly, by a faculty member determines how he or she educates students. Although the distinction between the paradigms has centered almost entirely on teaching methods and classroom environment, the differences between them are more fundamental. The paradigm determines the instructor's educational assumptions, educational goals, and assessment of results. Further, it determines the instructor's sense of educational responsibilities, the relationship with students, and motivational and mentoring responsibilities. Therefore, the peer review of an instructor teaching with one paradigm by reviewers who teach with the other risks being unfair and misleading. Complicating the issue are the .invisibility. of the Teaching-Centered Paradigm to most instructors who use it and the common use of Learning-Centered teaching methods or aims by instructors who still follow the Teaching-Centered Paradigm. Owing to the increase in numbers of Learning-Centered instructors, peer review now requires greater sensitivity by reviewers than before. Aligning the appropriate tools for peer review with the teaching implications of paradigm choice is the object of this paper.},
	number = {5},
	urldate = {2020-03-03},
	journal = {Journal of Geoscience Education},
	author = {McManus, Dean A.},
	month = nov,
	year = {2001},
	note = {Publisher: Routledge
\_eprint: https://doi.org/10.5408/1089-9995-49.5.423},
	keywords = {Education {\textendash} general, education {\textendash} geoscience, education {\textendash} peer review of teaching, education {\textendash} science, education {\textendash} testing and evaluation},
	pages = {423--434},
	file = {McManus-2001-The Two Paradigms of Education and the Peer Review of Teaching.pdf:/Users/lauriej/Box Sync/Zotero_library/2001/McManus-2001-The Two Paradigms of Education and the Peer Review of Teaching.pdf:application/pdf;Snapshot:/Users/lauriej/Zotero/storage/LYL22SWD/1089-9995-49.5.html:text/html}
}

