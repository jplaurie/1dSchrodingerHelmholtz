	file = {Snapshot:/Users/lauriej/Zotero/storage/SAZGQ4CB/1.html:text/html;Tobias-Marston-2017-Direct statistical simulation of jets and vortices in 2D flows.pdf:/Users/lauriej/Box/Zotero_library/2017/Tobias-Marston-2017-Direct statistical simulation of jets and vortices in 2D flows.pdf:application/pdf}
}

@article{tobias_three-dimensional_2017,
	title = {Three-dimensional rotating {Couette} flow via the generalised quasilinear approximation},
	volume = {810},
	issn = {0022-1120, 1469-7645},
	url = {https://www.cambridge.org/core/journals/journal-of-fluid-mechanics/article/threedimensional-rotating-couette-flow-via-the-generalised-quasilinear-approximation/7F9BFAAEAA3034F58A02E939397196DA},
	doi = {10.1017/jfm.2016.727},
	abstract = {We examine the effectiveness of the generalised quasilinear (GQL) approximation introduced by Marston et~al.~(Phys. Rev. Lett., vol.~116~(21), 2016, 214501). This approximation splits the variables into large and small scales in directions where there is a translational symmetry and removes nonlinear interactions involving only small scales. We utilise as a paradigm problem three-dimensional, turbulent, rotating Couette flow. We compare the results obtained from direct numerical solution of the equations with those from quasilinear (QL) and GQL calculations. In this three-dimensional setting, there is a choice of cutoff wavenumber for the GQL approximation both in the streamwise and in the spanwise directions. We demonstrate that the GQL approximation significantly improves the accuracy of mean flows, spectra and two-point correlation functions over models that are quasilinear in any of the translationally invariant directions, even if only a few streamwise and spanwise modes are included. We argue that this provides significant support for a programme of direct statistical simulation utilising the GQL approximation.},
	language = {en},
	urldate = {2019-12-17},
	journal = {Journal of Fluid Mechanics},
	author = {Tobias, S. M. and Marston, J. B.},
	month = jan,
	year = {2017},
	keywords = {rotating turbulence, turbulence modelling, turbulent flows},
	pages = {412--428},
	file = {Snapshot:/Users/lauriej/Zotero/storage/2YLQPQQR/7F9BFAAEAA3034F58A02E939397196DA.html:text/html;Tobias-Marston-2016-Three-Dimensional Rotating Couette Flow Via The Generalised Quasilinear.pdf:/Users/lauriej/Box/Zotero_library/2016/Tobias-Marston-2016-Three-Dimensional Rotating Couette Flow Via The Generalised Quasilinear.pdf:application/pdf;Tobias-Marston-2017-Three-dimensional rotating Couette flow via the generalised quasilinear.pdf:/Users/lauriej/Box/Zotero_library/2017/Tobias-Marston-2017-Three-dimensional rotating Couette flow via the generalised quasilinear.pdf:application/pdf}
