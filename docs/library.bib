}

@article{yin_alternative_2003,
	title = {Alternative statistical-mechanical descriptions of decaying two-dimensional turbulence in terms of {\textquotedblleft}patches{\textquotedblright} and {\textquotedblleft}points{\textquotedblright}},
	volume = {15},
	issn = {1070-6631, 1089-7666},
	url = {http://scitation.aip.org/content/aip/journal/pof2/15/7/10.1063/1.1578078},
	doi = {10.1063/1.1578078},
	abstract = {Numerical and analytical studies of decaying, two-dimensional Navier{\textendash}Stokes (NS) turbulence at high Reynolds numbers are reported. The effort is to determine computable distinctions between two different formulations of maximum entropy predictions for the decayed, late-time state. Though these predictions might be thought to apply only to the ideal Euler equations, there have been surprising and imperfectly understood correspondences between the long-time computations of decaying states of NS flows and the results of the maximum entropy analyses. Both formulations define an entropy using a somewhat ad hoc discretization of vorticity into {\textquotedblleft}particles.{\textquotedblright} Point-particle statistical methods are used to define an entropy, before passing to a mean-field approximation. In one case, the particles are delta-function parallel {\textquotedblleft}line{\textquotedblright} vortices ({\textquotedblleft}points,{\textquotedblright} in two dimensions), and in the other, they are finite-area, mutually exclusive convected {\textquotedblleft}patches{\textquotedblright} of vorticity which only in the limit of zero area become {\textquotedblleft}points.{\textquotedblright} The former are assumed to obey Boltzmann statistics, and the latter, Lynden-Bell statistics. Clearly, there is no unique way to reach a continuous, differentiable vorticity distribution as a mean-field limit by either method. The simplest method of taking equal-strength points and equal-strength, equal-area patches is chosen here, no reason being apparent for attempting anything more complicated. In both cases, a nonlinear partial differential equation results for the stream function of the {\textquotedblleft}most probable,{\textquotedblright} or maximum entropy, state, compatible with conserved total energy and positive and negative velocity fluxes. These amount to generalizations of the {\textquotedblleft}sinh-Poisson{\textquotedblright} equation which has become familiar from the {\textquotedblleft}point{\textquotedblright} formulation. They have many solutions and only one of them maximizes the entropy from which it was derived, globally. These predictions can differ for the point and patch discretizations. The intent here is to use time-dependent, spectral-method direct numerical simulation of the Navier{\textendash}Stokes equation to see if initial conditions which should relax toward the different late-time states under the two formulations actually do so.},
	number = {7},
	urldate = {2016-10-24},
	journal = {Physics of Fluids (1994-present)},
	author = {Yin, Z. and Montgomery, D. C. and Clercx, H. J. H.},
	month = jul,
	year = {2003},
	pages = {1937--1953},
	file = {Yin et al-2003-Alternative statistical-mechanical descriptions of decaying two-dimensional.pdf:/Users/lauriej/Box/Zotero_library/2003/Yin et al-2003-Alternative statistical-mechanical descriptions of decaying two-dimensional.pdf:application/pdf}
}

