	file = {Hohenberg-Halperin-1977-Theory of dynamic critical phenomena.pdf:/Users/lauriej/Box/Zotero_library/1977/Hohenberg-Halperin-1977-Theory of dynamic critical phenomena.pdf:application/pdf}
}

