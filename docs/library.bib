}

@article{baggaley_kelvin-wave_2014,
	title = {Kelvin-wave cascade in the vortex filament model},
	volume = {89},
	url = {http://link.aps.org/doi/10.1103/PhysRevB.89.014504},
	doi = {10.1103/PhysRevB.89.014504},
	abstract = {The small-scale energy-transfer mechanism in zero-temperature superfluid turbulence of helium-4 is still a widely debated topic. Currently, the main hypothesis is that weakly nonlinear interacting Kelvin waves (KWs) transfer energy to sufficiently small scales such that energy is dissipated as heat via phonon excitations. Theoretically, there are at least two proposed theories for Kelvin-wave interactions. We perform the most comprehensive numerical simulation of weakly nonlinear interacting KWs to date and show, using a specially designed numerical algorithm incorporating the full Biot-Savart equation, that our results are consistent with the nonlocal six-wave KW interactions as proposed by L'vov and Nazarenko.},
	number = {1},
	urldate = {2014-07-02},
	journal = {Physical Review B},
	author = {Baggaley, Andrew W. and Laurie, Jason},
	month = jan,
	year = {2014},
	keywords = {Quantum Turbulence},
	pages = {014504},
	file = {APS Snapshot:/Users/lauriej/Zotero/storage/8W7DN4US/PhysRevB.89.html:text/html;Baggaley-Laurie-2014-Kelvin-wave cascade in the vortex filament model.pdf:/Users/lauriej/Box/Zotero_library/2014/Baggaley-Laurie-2014-Kelvin-wave cascade in the vortex filament model.pdf:application/pdf}
}

@article{leadbeater_decay_2003,
	title = {Decay of superfluid turbulence via {Kelvin}-wave radiation},
	volume = {67},
