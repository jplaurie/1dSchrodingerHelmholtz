}

@article{wan_model_2015,
	title = {Model the nonlinear instability of wall-bounded shear flows as a rare event: a study on two-dimensional {Poiseuille} flow},
	volume = {28},
	issn = {0951-7715},
	shorttitle = {Model the nonlinear instability of wall-bounded shear flows as a rare event},
	url = {http://iopscience.iop.org/0951-7715/28/5/1409},
	doi = {10.1088/0951-7715/28/5/1409},
	abstract = {In this work, we study the nonlinear instability of two-dimensional (2D) wall-bounded shear flows from the large deviation point of view. The main idea is to consider the Navier{\textendash}Stokes equations perturbed by small noise in force and then examine the noise-induced transitions between the two coexisting stable solutions due to the subcritical bifurcation. When the amplitude of the noise goes to zero, the Freidlin{\textendash}Wentzell (F{\textendash}W) theory of large deviations defines the most probable transition path in the phase space, which is the minimizer of the F{\textendash}W action functional and characterizes the development of the nonlinear instability subject to small random perturbations. Based on such a transition path we can define a critical Reynolds number for the nonlinear instability in the probabilistic sense. Then the action-based stability theory is applied to study the 2D Poiseuille flow in a short channel.},
	language = {en},
	number = {5},
	urldate = {2015-04-21},
	journal = {Nonlinearity},
	author = {Wan, Xiaoliang and Yu, Haijun and Weinan, E.},
	month = may,
	year = {2015},
	pages = {1409},
	file = {Snapshot:/Users/lauriej/Zotero/storage/AM9CBQDD/Wan et al. - 2015 - Model the nonlinear instability of wall-bounded sh.html:text/html;Wan et al-2015-Model the nonlinear instability of wall-bounded shear flows as a rare event.pdf:/Users/lauriej/Box/Zotero_library/2015/Wan et al-2015-Model the nonlinear instability of wall-bounded shear flows as a rare event.pdf:application/pdf}
}

@article{josserand_coalescence_1997,
	title = {Coalescence and {Droplets} in the {Subcritical} {Nonlinear} {Schr}{\textbackslash}"odinger {Equation}},
	volume = {78},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.78.1215},
	doi = {10.1103/PhysRevLett.78.1215},
	abstract = {We describe here the coalescence and formation of droplets, in a Hamiltonian kinetics of a first order phase transition. In the process of coalescence, the typical linear size of single phase domains grows as a power of time. The density correlation function follows the usual self-similar dynamic scaling. For different initial conditions, we observe the nucleation and dynamics of stable pulses. The stability of such pulses in one dimension is also computed. Both results may be relevant to superfluid He4 cavitation or for filamentation in nonlinear optics and for the recent evidence of Bose-Einstein condensation in Li7.},
	number = {7},
