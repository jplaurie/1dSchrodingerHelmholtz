	pages = {785--791},
	file = {L{\textquoteright}vov-Nazarenko-2010-Weak turbulence of Kelvin waves in superfluid He.pdf:/Users/lauriej/Box/Zotero_library/2010/L{\textquoteright}vov-Nazarenko-2010-Weak turbulence of Kelvin waves in superfluid He.pdf:application/pdf}
}

