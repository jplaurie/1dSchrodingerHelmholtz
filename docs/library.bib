	url = {http://www.nature.com/nphys/journal/v6/n6/abs/nphys1674.html},
	doi = {10.1038/nphys1674},
	abstract = {There is a missing link between the macroscopic properties of turbulent flows, such as the frictional drag of a wall-bounded flow, and the turbulent spectrum. The turbulent spectrum is a power law of exponent $\alpha$ (the {\textquoteleft}spectral exponent{\textquoteright}) that gives the characteristic velocity of a turbulent fluctuation (or {\textquoteleft}eddy{\textquoteright}) of size s as a function of s (ref. 1). Here we seek the missing link by comparing the frictional drag in soap-film flows, where $\alpha$=3 (refs 9, 10), and in pipe flows, where $\alpha$=5/3 (refs 11, 12). For moderate values of the Reynolds number Re, we find experimentally that in soap-film flows the frictional drag scales as Re-1/2, whereas in pipe flows the frictional drag scales as Re-1/4. Each of these scalings may be predicted from the attendant value of $\alpha$ by using a new theory, in which the frictional drag is explicitly linked to the turbulent spectrum.},
	language = {en},
	number = {6},
	urldate = {2016-10-26},
	journal = {Nature Physics},
	author = {Tran, Tuan and Chakraborty, Pinaki and Guttenberg, Nicholas and Prescott, Alisia and Kellay, Hamid and Goldburg, Walter and Goldenfeld, Nigel and Gioia, Gustavo},
	month = jun,
	year = {2010},
	pages = {438--441},
	file = {Tran et al-2010-Macroscopic effects of the spectral structure in turbulent flows.pdf:/Users/lauriej/Box/Zotero_library/2010/Tran et al-2010-Macroscopic effects of the spectral structure in turbulent flows.pdf:application/pdf}
}

@article{majda_remarkable_2000,
	title = {Remarkable statistical behavior for truncated {Burgers}{\textendash}{Hopf} dynamics},
	volume = {97},
	issn = {0027-8424, 1091-6490},
	url = {http://www.pnas.org/content/97/23/12413},
	doi = {10.1073/pnas.230433997},
	abstract = {A simplified one-dimensional model system is introduced and studied here that exhibits intrinsic chaos with many degrees of freedom as well as increased predictability and slower decay of correlations for the large-scale features of the system. These are important features in common with vastly more complex problems involving climate modeling or molecular biological systems. This model is a suitable approximation of the Burgers{\textendash}Hopf equation involving Galerkin projection on Fourier modes. The model has a detailed mathematical structure that leads to a well-defined equilibrium statistical theory as well as a simple scaling theory for correlations. The numerical evidence presented here strongly supports the behavior predicted from these statistical theories. Unlike the celebrated dissipative and dispersive approximations of the Burgers{\textendash}Hopf equation, which exhibit exactly solvable and/or completely integrable behavior, these model approximations have strong intrinsic chaos with ergodic behavior.},
	language = {en},
	number = {23},
	urldate = {2016-10-25},
	journal = {Proceedings of the National Academy of Sciences},
	author = {Majda, Andrew J. and Timofeyev, Ilya},
	month = jul,
	year = {2000},
	pmid = {11050184},
	pages = {12413--12417},
	file = {Majda-Timofeyev-2000-Remarkable statistical behavior for truncated Burgers{\textendash}Hopf dynamics.pdf:/Users/lauriej/Box/Zotero_library/2000/Majda-Timofeyev-2000-Remarkable statistical behavior for truncated Burgers{\textendash}Hopf dynamics.pdf:application/pdf}
}

@article{potters_sampling_2013,
	title = {Sampling microcanonical measures of the {2D} {Euler} equations through {Creutz}{\textquoteright}s algorithm: a phase transition from disorder to order when energy is increased},
	volume = {2013},
	issn = {1742-5468},
	shorttitle = {Sampling microcanonical measures of the {2D} {Euler} equations through {Creutz}{\textquoteright}s algorithm},
	url = {http://stacks.iop.org/1742-5468/2013/i=02/a=P02017},
	doi = {10.1088/1742-5468/2013/02/P02017},
	abstract = {The 2D Euler equations are basic examples of fluid models for which a microcanonical measure can be constructed from first principles. This measure is defined through finite-dimensional approximations and a limiting procedure. Creutz{\textquoteright}s algorithm is a microcanonical generalization of the Metropolis{\textendash}Hastings algorithm (to sample Gibbs measures, in the canonical ensemble). We prove that Creutz{\textquoteright}s algorithm can sample finite-dimensional approximations of the 2D Euler microcanonical measures (incorporating fixed energy and other invariants). This is essential as microcanonical and canonical measures are known to be inequivalent at some values of energy and vorticity distribution. Creutz{\textquoteright}s algorithm is used to check predictions from the mean-field statistical mechanics theory of the 2D Euler equations (the Robert{\textendash}Sommeria{\textendash}Miller theory). We find full agreement with theory. Three different ways to compute the temperature give consistent results. Using Creutz{\textquoteright}s algorithm, a first-order phase transition never observed previously and a situation of statistical ensemble inequivalence are found and studied. Strikingly, and in contrast to the usual statistical mechanics interpretations, this phase transition appears from a disordered phase to an ordered phase (with fewer symmetries) when the energy is increased. We explain this paradox.},
	language = {en},
	number = {02},
	urldate = {2016-10-25},
	journal = {Journal of Statistical Mechanics: Theory and Experiment},
	author = {Potters, Max and Vaillant, Timothee and Bouchet, Freddy},
	year = {2013},
	pages = {P02017},
	file = {Potters et al-2013-Sampling microcanonical measures of the 2D Euler equations through Creutz{\textquoteright}s.pdf:/Users/lauriej/Box/Zotero_library/2013/Potters et al-2013-Sampling microcanonical measures of the 2D Euler equations through Creutz{\textquoteright}s.pdf:application/pdf}
}

