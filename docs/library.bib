@article{blanchet_gravitational_2002,
	title = {Gravitational {Radiation} from {Post}-{Newtonian} {Sources} and {Inspiralling} {Compact} {Binaries}},
	volume = {5},
	issn = {2367-3613, 1433-8351},
	url = {https://link.springer.com/article/10.12942/lrr-2002-3},
	doi = {10.12942/lrr-2002-3},
	abstract = {The article reviews the current status of a theoretical approach to the problem of the emission of gravitational waves by isolated systems in the context of general relativity. Part A of the article deals with general post-Newtonian sources. The exterior field of the source is investigated by means of a combination of analytic post-Minkowskian and multipolar approximations. The physical observables in the far-zone of the source are described by a specific set of radiative multipole moments. By matching the exterior solution to the metric of the post-Newtonian source in the near-zone we obtain the explicit expressions of the source multipole moments. The relationships between the radiative and source moments involve many nonlinear multipole interactions, among them those associated with the tails (and tails-of-tails of gravitational waves. Part B of the article is devoted to the application to compact binary systems. We present the equations of binary motion, and the associated Lagrangian and Hamiltonian, at the third post-Newtonian (3PN) order beyond the Newtonian acceleration. The gravitational-wave energy flux, taking consistently into account the relativistic corrections in the binary moments as well as the various tail effects, is derived through 3.5PN order with respect to the quadrupole formalism. The binary{\textquoteright}s orbital phase, whose prior knowledge is crucial for searching and analyzing the signals from inspiralling compact binaries, is deduced from an energy balance argument.},
	language = {en},
	number = {1},
	urldate = {2017-11-24},
	journal = {Living Reviews in Relativity},
	author = {Blanchet, Luc},
	month = dec,
	year = {2002},
	pages = {3},
	file = {Blanchet-2002-Gravitational Radiation from Post-Newtonian Sources and Inspiralling Compact.pdf:/Users/lauriej/Box/Zotero_library/2002/Blanchet-2002-Gravitational Radiation from Post-Newtonian Sources and Inspiralling Compact.pdf:application/pdf;Snapshot:/Users/lauriej/Zotero/storage/55YJRQ42/lrr-2002-3.html:text/html}
}

@article{reeves_enstrophy_2017,
	title = {Enstrophy {Cascade} in {Decaying} {Two}-{Dimensional} {Quantum} {Turbulence}},
	volume = {119},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.119.184502},
	doi = {10.1103/PhysRevLett.119.184502},
	abstract = {We report evidence for an enstrophy cascade in large-scale point-vortex simulations of decaying two-dimensional quantum turbulence. Devising a method to generate quantum vortex configurations with kinetic energy narrowly localized near a single length scale, the dynamics are found to be well characterized by a superfluid Reynolds number Res that depends only on the number of vortices and the initial kinetic energy scale. Under free evolution the vortices exhibit features of a classical enstrophy cascade, including a k-3 power-law kinetic energy spectrum, and constant enstrophy flux associated with inertial transport to small scales. Clear signatures of the cascade emerge for N?500 vortices. Simulating up to very large Reynolds numbers (N=32 768 vortices), additional features of the classical theory are observed: the Kraichnan-Batchelor constant is found to converge to C'?1.6, and the width of the k-3 range scales as Re1/2s.},
	number = {18},
	urldate = {2017-11-24},
	journal = {Physical Review Letters},
	author = {Reeves, Matthew T. and Billam, Thomas P. and Yu, Xiaoquan and Bradley, Ashton S.},
	month = oct,
	year = {2017},
	pages = {184502},
	file = {APS Snapshot:/Users/lauriej/Zotero/storage/6CPN8QXE/PhysRevLett.119.html:text/html;Reeves et al-2017-Enstrophy Cascade in Decaying Two-Dimensional Quantum Turbulence.pdf:/Users/lauriej/Box/Zotero_library/2017/Reeves et al-2017-Enstrophy Cascade in Decaying Two-Dimensional Quantum Turbulence.pdf:application/pdf}
}

@article{galtier_turbulence_2017,
	title = {Turbulence of {Weak} {Gravitational} {Waves} in the {Early} {Universe}},
	volume = {119},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.119.221101},
	doi = {10.1103/PhysRevLett.119.221101},
	abstract = {We study the statistical properties of an ensemble of weak gravitational waves interacting nonlinearly in a flat space-time. We show that the resonant three-wave interactions are absent and develop a theory for four-wave interactions in the reduced case of a 2.5+1 diagonal metric tensor. In this limit, where only plus-polarized gravitational waves are present, we derive the interaction Hamiltonian and consider the asymptotic regime of weak gravitational wave turbulence. Both direct and inverse cascades are found for the energy and the wave action, respectively, and the corresponding wave spectra are derived. The inverse cascade is characterized by a finite-time propagation of the metric excitations{\textemdash}a process similar to an explosive nonequilibrium Bose{\textendash}Einstein condensation, which provides an efficient mechanism to ironing out small-scale inhomogeneities. The direct cascade leads to an accumulation of the radiation energy in the system. These processes might be important for understanding the early Universe where a background of weak nonlinear gravitational waves is expected.},
	number = {22},
	urldate = {2017-12-04},
	journal = {Physical Review Letters},
	author = {Galtier, S{\'e}bastien and Nazarenko, Sergey V.},
	month = nov,
	year = {2017},
	pages = {221101},
	file = {Galtier-Nazarenko-2017-Turbulence of Weak Gravitational Waves in the Early Universe.pdf:/Users/lauriej/Box/Zotero_library/2017/Galtier-Nazarenko-2017-Turbulence of Weak Gravitational Waves in the Early Universe.pdf:application/pdf}
}

