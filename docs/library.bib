@article{slomka_stokes_2018,
	title = {Stokes' second problem and reduction of inertia in active fluids},
	volume = {3},
	url = {https://link.aps.org/doi/10.1103/PhysRevFluids.3.103304},
	doi = {10.1103/PhysRevFluids.3.103304},
	abstract = {We study a generalized Navier-Stokes model describing the coherent thin-film flows in semiconcentrated suspensions of ATP-driven microtubules or swimming cells that are enclosed by a moving ring-shaped container. Considering Stokes' second problem, which concerns the motion of an oscillating boundary, our numerical analysis predicts that a periodically rotating ring will oscillate at a higher frequency in an active fluid than in a passive fluid, due to an activity-induced reduction of the fluid inertia. In the case of a freely suspended fluid-container system that is isolated from external forces or torques, active-fluid stresses can induce large fluctuations in the container's angular momentum if the confinement radius matches certain multiples of the intrinsic vortex size of the active suspension. This effect could be utilized to transform collective microscopic swimmer activity into macroscopic motion in optimally tuned geometries.},
	number = {10},
	urldate = {2018-11-02},
	journal = {Physical Review Fluids},
	author = {S{\l }omka, Jonasz and Townsend, Alex and Dunkel, J{\"o}rn},
	month = oct,
	year = {2018},
	pages = {103304},
	file = {APS Snapshot:/Users/lauriej/Zotero/storage/CG64MWMP/PhysRevFluids.3.html:text/html;S{\l }omka et al-2018-Stokes' second problem and reduction of inertia in active fluids.pdf:/Users/lauriej/Box/Zotero_library/2018/S{\l }omka et al-2018-Stokes' second problem and reduction of inertia in active fluids.pdf:application/pdf}
}

@article{parker_controlled_2004,
	title = {Controlled {Vortex}-{Sound} {Interactions} in {Atomic} {Bose}-{Einstein} {Condensates}},
	volume = {92},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.92.160403},
	doi = {10.1103/PhysRevLett.92.160403},
	abstract = {The low temperature dynamics of a vortex in a trapped quasi-two-dimensional Bose-Einstein condensate are studied quantitatively. Precession of an off-centered vortex in a dimple trap, embedded in a weaker harmonic trap, leads to the emission of sound in a dipolar radiation pattern. Sound emission and reabsorption can be controlled by varying the depth of the dimple. In a shallow dimple, the power emitted is proportional to the vortex acceleration-squared over the precession frequency, whereas for a deep dimple, periodic sound reabsorption stabilizes the vortex against radiation-induced decay.},
	number = {16},
