	abstract = {The construct of identity has been used widely in mathematics education in order to understand how students (and teachers) relate to and engage with the subject (Kaasila, 2007; Sfard \& Prusak, 2005; Boaler, 2002). Drawing on cultural historical activity theory (CHAT), this paper adopts Leont{\textquoteright}ev{\textquoteright}s notion of leading activity in order to explore the key {\textquoteleft}significant{\textquoteright} activities that are implicated in the development of students{\textquoteright} reflexive understanding of self and how this may offer differing relations with mathematics. According to Leont{\textquoteright}ev (1981), leading activities are those which are significant to the development of the individual{\textquoteright}s psyche through the emergence of new motives for engagement. We suggest that alongside new motives for engagement comes a new understanding of self{\textemdash}a leading identity{\textemdash}which reflects a hierarchy of our motives. Narrative analysis of interviews with two students (aged 16{\textendash}17 years old) in post-compulsory education, Mary and Lee, are presented. Mary holds a stable {\textquoteleft}vocational{\textquoteright} leading identity throughout her narrative and, thus, her motive for studying mathematics is defined by its {\textquoteleft}use value{\textquoteright} in terms of pursuing this vocation. In contrast, Lee develops a leading identity which is focused on the activity of studying and becoming a university student. As such, his motive for study is framed in terms of the exchange value of the qualifications he hopes to obtain. We argue that this empirical grounding of leading activity and leading identity offers new insights into students{\textquoteright} identity development.},
	language = {en},
	number = {1},
	urldate = {2019-05-16},
	journal = {Educational Studies in Mathematics},
	author = {Black, Laura and Williams, Julian and Hernandez-Martinez, Paul and Davis, Pauline and Pampaka, Maria and Wake, Geoff},
	month = nov,
	year = {2009},
	keywords = {Aspirations, Cultural models, Cultural{\textendash}historical activity theory, Identity, Leading activity},
	pages = {55},
	file = {Springer Full Text PDF:/Users/lauriej/Zotero/storage/KX2RTMRD/Black et al. - 2009 - Developing a {\textquoteleft}leading identity{\textquoteright} the relationship .pdf:application/pdf}
}

