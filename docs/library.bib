	file = {Aarts-de Waele-1994-Numerical investigation of the flow properties of He II.pdf:/Users/lauriej/Box/Zotero_library/1994/Aarts-de Waele-1994-Numerical investigation of the flow properties of He II.pdf:application/pdf}
}

@article{chertkov_dynamics_2007,
	title = {Dynamics of {Energy} {Condensation} in {Two}-{Dimensional} {Turbulence}},
	volume = {99},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.99.084501},
	doi = {10.1103/PhysRevLett.99.084501},
	abstract = {We report a numerical study, supplemented by phenomenological explanations, of {\textquotedblleft}energy condensation{\textquotedblright} in forced 2D turbulence in a biperiodic box. Condensation is a finite size effect which occurs after the standard inverse cascade reaches the size of the system. It leads to the emergence of a coherent vortex dipole. We show that the time growth of the dipole is self-similar, and it contains most of the injected energy, thus resulting in an energy spectrum which is markedly steeper than the standard k-5/3 one. Once the coherent component is subtracted, however, the remaining fluctuations have a spectrum close to k-1. The fluctuations decay slowly as the coherent part grows.},
	number = {8},
	urldate = {2014-07-04},
	journal = {Physical Review Letters},
	author = {Chertkov, M. and Connaughton, C. and Kolokolov, I. and Lebedev, V.},
	month = aug,
	year = {2007},
	pages = {084501},
	file = {APS Snapshot:/Users/lauriej/Zotero/storage/B5PR9Z7Q/PhysRevLett.99.html:text/html;Chertkov et al-2007-Dynamics of Energy Condensation in Two-Dimensional Turbulence.pdf:/Users/lauriej/Box/Zotero_library/2007/Chertkov et al-2007-Dynamics of Energy Condensation in Two-Dimensional Turbulence.pdf:application/pdf}
}

@article{holm_euler-poincare_1998,
	title = {The {Euler}-{Poincar{\'e}} {Equations} and {Semidirect} {Products} with {Applications} to {Continuum} {Theories}},
	volume = {137},
	issn = {0001-8708},
	url = {http://www.sciencedirect.com/science/article/pii/S0001870898917212},
	doi = {10.1006/aima.1998.1721},
	abstract = {We study Euler{\textendash}Poincar{\'e} systems (i.e., the Lagrangian analogue of Lie{\textendash}Poisson Hamiltonian systems) defined on semidirect product Lie algebras. We first give a derivation of the Euler{\textendash}Poincar{\'e} equations for a parameter dependent Lagrangian by using a variational principle of Lagrange d'Alembert type. Then we derive an abstract Kelvin{\textendash}Noether theorem for these equations. We also explore their relation with the theory of Lie{\textendash}Poisson Hamiltonian systems defined on the dual of a semidirect product Lie algebra. The Legendre transformation in such cases is often not invertible; thus, it does not produce a corresponding Euler{\textendash}Poincar{\'e} system on that Lie algebra. We avoid this potential difficulty by developing the theory of Euler{\textendash}Poincar{\'e} systems entirely within the Lagrangian framework. We apply the general theory to a number of known examples, including the heavy top, ideal compressible fluids and MHD. We also use this framework to derive higher dimensional Camassa{\textendash}Holm equations, which have many potentially interesting analytical properties. These equations are Euler{\textendash}Poincar{\'e} equations for geodesics on diffeomorphism groups (in the sense of the Arnold program) but where the metric isH1rather thanL2.},
	number = {1},
	urldate = {2014-07-02},
	journal = {Advances in Mathematics},
	author = {Holm, Darryl D and Marsden, Jerrold E and Ratiu, Tudor S},
	month = jul,
	year = {1998},
	pages = {1--81},
	file = {Holm et al-1998-The Euler-Poincar{\'e} Equations and Semidirect Products with Applications to.pdf:/Users/lauriej/Box/Zotero_library/1998/Holm et al-1998-The Euler-Poincar{\'e} Equations and Semidirect Products with Applications to.pdf:application/pdf;ScienceDirect Snapshot:/Users/lauriej/Zotero/storage/9ZDK8NBK/S0001870898917212.html:text/html}
}

@article{shats_suppression_2007,
	title = {Suppression of {Turbulence} by {Self}-{Generated} and {Imposed} {Mean} {Flows}},
	volume = {99},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.99.164502},
	doi = {10.1103/PhysRevLett.99.164502},
	abstract = {The first direct experimental evidence of the suppression of quasi-two-dimensional turbulence by mean flows is presented. The flow either is induced externally or appears in the process of spectral condensation due to an inverse cascade in bounded turbulence. The observed suppression of large scales is consistent with an expected reduction in the correlation time of turbulent eddies due to shearing. At high flow velocities, sweeping of the forcing-scale vortices reduces the energy input, leading to a reduction in the turbulence level.},
	number = {16},
	urldate = {2014-07-04},
	journal = {Physical Review Letters},
	author = {Shats, M. G. and Xia, H. and Punzmann, H. and Falkovich, G.},
	month = oct,
