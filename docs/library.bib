@article{kolokolov_velocity_2016,
	title = {Velocity statistics inside coherent vortices generated by the inverse cascade of 2-{D} turbulence},
	volume = {809},
	issn = {0022-1120, 1469-7645},
	url = {https://www.cambridge.org/core/journals/journal-of-fluid-mechanics/article/velocity-statistics-inside-coherent-vortices-generated-by-the-inverse-cascade-of-2d-turbulence/A9D3D0488D629C2B27760D7DD951DD41},
