	url = {http://arxiv.org/abs/1404.5863},
	abstract = {We study the stochastic Allen-Cahn equation driven by a noise term with intensity \${\textbackslash}sqrt\{{\textbackslash}varepsilon\}\$ and correlation length \${\textbackslash}delta\$ in two and three spatial dimensions. We study diagonal limits \${\textbackslash}delta, {\textbackslash}varepsilon {\textbackslash}to 0\$ and describe fully the large deviation behaviour depending on the relationship between \${\textbackslash}delta\$ and \${\textbackslash}varepsilon\$. The recently developed theory of regularity structures allows to fully analyse the behaviour of solutions for vanishing correlation length \${\textbackslash}delta\$ and fixed noise intensity \${\textbackslash}varepsilon\$. One key fact is that in order to get non-trivial limits as \${\textbackslash}delta {\textbackslash}to 0\$, it is necessary to introduce diverging counterterms. The theory of regularity structures allows to rigorously analyse this renormalisation procedure for a number of interesting equations. Our main result is a large deviation principle for these renormalised solutions. One interesting feature of this result is that the diverging renormalisation constants disappear at the level of the large deviations rate function. We apply this result to derive a sharp condition on \${\textbackslash}delta, {\textbackslash}varepsilon\$ that guarantees a large deviation principle for diagonal schemes \${\textbackslash}varepsilon, {\textbackslash}delta {\textbackslash}to 0\$ for the equation without renormalisation.},
	urldate = {2014-11-16},
