	file = {Berloff-2009-Vortex splitting in subcritical nonlinear Schr{\"o}dinger equations.pdf:/Users/lauriej/Box/Zotero_library/2009/Berloff-2009-Vortex splitting in subcritical nonlinear Schr{\"o}dinger equations.pdf:application/pdf}
}

@article{dalfovo_structure_1992,
	title = {Structure of vortices in helium at zero temperature},
	volume = {46},
	url = {http://link.aps.org/doi/10.1103/PhysRevB.46.5482},
	doi = {10.1103/PhysRevB.46.5482},
	abstract = {A density-functional theory is used to investigate the structure of vortices in superfluid helium. The angular dependence of the many-body wave function is factorized following the Feynman-Onsager hypothesis. The density profile near the vortex axis is then calculated for different values of the external pressure. The profile shows damped stationary ripples with the roton wavelength, in agreement with the predictions of previous microscopic calculations. A critical negative pressure of 8 bars is found for the stability of a vortex line against a free expansion of the core. The application of the density-functional method to the problem of He3 impurities is also discussed.},
