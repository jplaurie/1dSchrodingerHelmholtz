@article{hall_experimental_1958,
	title = {An {Experimental} and {Theoretical} {Study} of {Torsional} {Oscillations} in {Uniformly} {Rotating} {Liquid} {Helium} {II}},
	volume = {245},
	issn = {1364-5021, 1471-2946},
	url = {http://rspa.royalsocietypublishing.org/content/245/1243/546},
	doi = {10.1098/rspa.1958.0100},
	abstract = {Measurements have been made of the period (2\${\textbackslash}pi \$/\${\textbackslash}Omega \$) of small torsional oscillations of an Andronikashvili disk system, superposed on a uniform rotation with angular velocity \${\textbackslash}omega \_\{0\}\$. If the changes in period are expressed formally as an effective density of liquid \${\textbackslash}rho {\textasciicircum}\{{\textbackslash}prime\}\$ that moves with the disks it is found that, for sufficiently rough disk surfaces and sufficiently small amplitudes of oscillation: (i) for \${\textbackslash}omega \_\{0\}{\textbackslash}gg {\textbackslash}Omega \$, \${\textbackslash}rho {\textasciicircum}\{{\textbackslash}prime\}\$/\${\textbackslash}rho \_\{s\}\$ increases monotonically from 0 to 1 with increasing \${\textbackslash}omega \_\{0\}\$ and increasing disk separation; (ii) for \${\textbackslash}omega \_\{0\}{\textbackslash}ll {\textbackslash}Omega \$, \${\textbackslash}rho {\textasciicircum}\{{\textbackslash}prime\}\$ can be either positive or negative; when plotted as a function of disk separation it shows a resonance-dispersion type of behaviour. These results can be explained by the vortex line model of Onsager and Feynman in terms of a transverse wave motion of the vortex lines, if it is supposed that the ends of the lines tend to stick to a sufficiently rough surface. The theory of these vortex waves has been worked out in some detail. The behaviour of the liquid is determined by a parameter \${\textbackslash}nu \$ = \${\textbackslash}epsilon \$/\${\textbackslash}rho \_\{s\}{\textbackslash}kappa \$, where \${\textbackslash}epsilon \$ is the energy of unit length of vortex line and \${\textbackslash}kappa \$ is the circulation round a line; comparison of theory and experiment gives \${\textbackslash}nu \$ = (8\${\textbackslash}cdot \$5 \${\textbackslash}pm \$ 1\${\textbackslash}cdot \$5) \${\textbackslash}times \$ 10\${\textasciicircum}\{-4\}\$ cm\${\textasciicircum}\{2\}\$s\${\textasciicircum}\{-1\}\$, some 25\% less than Feynman's theoretical estimate. In the final section some consequences of the existence of vortex waves are discussed.},
	language = {en},
	number = {1243},
	urldate = {2015-10-08},
	journal = {Proceedings of the Royal Society of London A: Mathematical, Physical and Engineering Sciences},
	author = {Hall, H. E.},
	month = jul,
	year = {1958},
	pages = {546--561},
	file = {Hall-1958-An Experimental and Theoretical Study of Torsional Oscillations in Uniformly.pdf:/Users/lauriej/Box/Zotero_library/1958/Hall-1958-An Experimental and Theoretical Study of Torsional Oscillations in Uniformly.pdf:application/pdf}
}

