@article{scott_structure_2012,
	title = {The structure of zonal jets in geostrophic turbulence},
	volume = {711},
	issn = {1469-7645},
	url = {http://journals.cambridge.org/article_S0022112012004107},
	doi = {10.1017/jfm.2012.410},
	abstract = {The structure of zonal jets arising in forced-dissipative, two-dimensional turbulent flow on the \${\textbackslash}ensuremath{\textbackslash}beta \$ -plane is investigated using high-resolution, long-time numerical integrations, with particular emphasis on the late-time distribution of potential vorticity. The structure of the jets is found to depend in a simple way on a single non-dimensional parameter, which may be conveniently expressed as the ratio \$L\_{\textbackslash}mathitRh / L\_{\textbackslash}varepsilon \$ , where \$L\_{\textbackslash}mathitRh = {\textbackslash}sqrtU/ {\textbackslash}ensuremath{\textbackslash}beta \$ and \$L\_{\textbackslash}varepsilon = {\textbackslash}mathop ({\textbackslash}varepsilon / {\textbackslash}ensuremath{\textbackslash}beta {\textasciicircum}3 ){\textbackslash}nolimits {\textasciicircum}1/ 5 \$ are two natural length scales arising in the problem; here \$U\$ may be taken as the r.m.s. velocity, \${\textbackslash}ensuremath{\textbackslash}beta \$ is the background gradient of potential vorticity in the north{\textendash}south direction, and \${\textbackslash}varepsilon \$ is the rate of energy input by the forcing. It is shown that jet strength increases with \$L\_{\textbackslash}mathitRh / L\_{\textbackslash}varepsilon \$ , with the limiting case of the potential vorticity staircase, comprising a monotonic, piecewise-constant profile in the north{\textendash}south direction, being approached for \$L\_{\textbackslash}mathitRh / L\_{\textbackslash}varepsilon {\textbackslash}ensuremath{\textbackslash}sim O(10)\$ . At lower values, eddies created by the forcing become sufficiently intense to continually disrupt the steepening of potential vorticity gradients in the jet cores, preventing strong jets from developing. Although detailed features such as the regularity of jet spacing and intensity are found to depend on the spectral distribution of the forcing, the approach of the staircase limit with increasing \$L\_{\textbackslash}mathitRh / L\_{\textbackslash}varepsilon \$ is robust across a variety of different forcing types considered.},
	urldate = {2015-03-12},
	journal = {Journal of Fluid Mechanics},
	author = {Scott, Richard K. and Dritschel, David G.},
	month = nov,
	year = {2012},
	pages = {576--598},
	file = {Scott-Dritschel-2012-The structure of zonal jets in geostrophic turbulence.pdf:/Users/lauriej/Box/Zotero_library/2012/Scott-Dritschel-2012-The structure of zonal jets in geostrophic turbulence.pdf:application/pdf}
}

@article{duri_hot-wire_2015,
