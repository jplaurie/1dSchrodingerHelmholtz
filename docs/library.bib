	issn = {0013-1962},
	shorttitle = {Cooperative {Learning} and {Gagn{\'e}}'s {Events} of {Instruction}},
	url = {https://www.jstor.org/stable/44427642},
	abstract = {[The purpose of this study was to determine how R. M. Gagn{\'e}'s learning theory and his events of instruction described and supported learning in a cooperative learning environment. The study was carried out in a fourth-grade classroom with 26 students where the instructor used a cooperative learning model. Data were gathered using naturalistic and case-study procedures. Findings supported the study's initial propositions: the events of instruction do occur within a cooperative learning environment, and different individuals, groups, or instructional materials may provide the events. An emergent finding described instantiation of the events in cooperative situations. The conclusion of the study was that Gagn{\'e}'s instructional theory and the events of instruction are compatible with and support cooperative learning's process-oriented, social-learning theory.]},
