}

@article{nazarenko_wave_2006,
	title = {Wave turbulence and vortices in {Bose}{\textendash}{Einstein} condensation},
	volume = {219},
	issn = {0167-2789},
	url = {http://www.sciencedirect.com/science/article/pii/S0167278906001758},
	doi = {10.1016/j.physd.2006.05.007},
	abstract = {We report a numerical study of turbulence and Bose{\textendash}Einstein condensation within the two-dimensional Gross{\textendash}Pitaevsky model with repulsive interaction. In the presence of weak forcing localized around some wave number in the Fourier space, we observe three qualitatively different evolution stages. At the initial stage a thermodynamic energy equipartition spectrum forms at both smaller and larger scales with respect to the forcing scale. This agrees with predictions of the four-wave kinetic equation of the Wave Turbulence (WT) theory. At the second stage, WT breaks down at large scales and the interactions become strongly nonlinear. Here, we observe formation of a gas of quantum vortices whose number decreases due to an annihilation process helped by the acoustic component. This process leads to formation of a coherent-phase Bose{\textendash}Einstein condensate. After such a coherent-phase condensate forms, evolution enters a third stage characterised by three-wave interactions of acoustic waves that can be described again using the WT theory.},
	number = {1},
	urldate = {2014-07-27},
	journal = {Physica D: Nonlinear Phenomena},
	author = {Nazarenko, Sergey and Onorato, Miguel},
	month = jul,
	year = {2006},
	pages = {1--12},
	file = {Nazarenko-Onorato-2006-Wave turbulence and vortices in Bose{\textendash}Einstein condensation.pdf:/Users/lauriej/Box/Zotero_library/2006/Nazarenko-Onorato-2006-Wave turbulence and vortices in Bose{\textendash}Einstein condensation.pdf:application/pdf}
}

@article{connaughton_dimensional_2003,
	series = {Complexity and {Nonlinearity} in {Physical} {Systems} -- {A} {Special} {Issue} to {Honor} {Alan} {Newell}},
	title = {Dimensional analysis and weak turbulence},
	volume = {184},
	issn = {0167-2789},
	url = {http://www.sciencedirect.com/science/article/pii/S0167278903002148},
	doi = {10.1016/S0167-2789(03)00214-8},
	abstract = {In the study of weakly turbulent wave systems possessing incomplete self-similarity, it is possible to use dimensional arguments to derive the scaling exponents of the Kolmogorov{\textendash}Zakharov spectra, provided the order of the resonant wave interactions responsible for nonlinear energy transfer is known. Furthermore, one can easily derive conditions for the breakdown of the weak turbulence approximation. It is found that for incompletely self-similar systems dominated by three wave interactions, the weak turbulence approximation usually cannot break down at small scales. It follows that such systems cannot exhibit small scale intermittency. For systems dominated by four wave interactions, the incomplete self-similarity property implies that the scaling of the interaction coefficient depends only on the physical dimension of the system. These results are used to build a complete picture of the scaling properties of the surface wave problem where both gravity and surface tension play a role. We argue that, for large values of the energy flux, there should be two weakly turbulent scaling regions matched together via a region of strongly nonlinear turbulence.},
	number = {1{\textendash}4},
	urldate = {2014-07-27},
	journal = {Physica D: Nonlinear Phenomena},
	author = {Connaughton, Colm and Nazarenko, Sergey and Newell, Alan C},
	month = oct,
	year = {2003},
	pages = {86--97},
	file = {Connaughton et al-2003-Dimensional analysis and weak turbulence.pdf:/Users/lauriej/Box/Zotero_library/2003/Connaughton et al-2003-Dimensional analysis and weak turbulence.pdf:application/pdf}
}

@article{dubrulle_interaction_1997,
