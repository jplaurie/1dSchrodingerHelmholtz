	month = apr,
	year = {2014},
	note = {arXiv: 1404.5863},
	file = {Hairer-Weber-2014-Large deviations for white-noise driven, nonlinear stochastic PDEs in two and.pdf:/Users/lauriej/Box/Zotero_library/2014/Hairer-Weber-2014-Large deviations for white-noise driven, nonlinear stochastic PDEs in two and.pdf:application/pdf}
}

