	file = {Chavaillaz et al-2012-Southern westerlies in LGM and future (RCP4.pdf:/Users/lauriej/Box/Zotero_library/2012/Chavaillaz et al-2012-Southern westerlies in LGM and future (RCP4.pdf:application/pdf}
}

@article{chen_sensitivity_2007,
	title = {Sensitivity of the {Latitude} of the {Surface} {Westerlies} to {Surface} {Friction}},
	volume = {64},
	issn = {0022-4928},
	url = {http://journals.ametsoc.org/doi/abs/10.1175/JAS3995.1},
	doi = {10.1175/JAS3995.1},
	abstract = {Abstract The sensitivity to surface friction of the latitude of the surface westerlies and the associated eddy-driven midlatitude jet is studied in an idealized dry GCM. The westerlies move poleward as the friction is reduced in strength. An increase in the eastward phase speed of midlatitude eddies is implicated as playing a central role in this shift. This shift in latitude is mainly determined by changes in the friction on the zonal mean flow rather than the friction on the eddies. If the friction on the zonal mean is reduced instantaneously, the response reveals two distinctive adjustment time scales. In the fast adjustment over the first 10{\textendash}20 days, there is an increase in the barotropic component of zonal winds and a substantial decrease in the eddy kinetic energy; the shift in the surface westerlies and jet latitude occurs in a slower adjustment. The space{\textendash}time eddy momentum flux spectra suggest that the key to the shift is a poleward movement in the subtropical critical latitude associated with the faster eastward phase speeds in the dominant midlatitude eddies. The view is supported by simulating the upper-tropospheric dynamics in a stochastically stirred nonlinear shallow water model.},
	number = {8},
	urldate = {2014-09-09},
	journal = {Journal of the Atmospheric Sciences},
	author = {Chen, Gang and Held, Isaac M. and Robinson, Walter A.},
	month = aug,
	year = {2007},
	pages = {2899--2915},
	file = {Chen et al-2007-Sensitivity of the Latitude of the Surface Westerlies to Surface Friction.pdf:/Users/lauriej/Box/Zotero_library/2007/Chen et al-2007-Sensitivity of the Latitude of the Surface Westerlies to Surface Friction.pdf:application/pdf}
}

