	pages = {658--663},
	file = {Punzmann et al-2014-Generation and reversal of surface flows by propagating waves.pdf:/Users/lauriej/Box/Zotero_library/2014/Punzmann et al-2014-Generation and reversal of surface flows by propagating waves.pdf:application/pdf}
}

@article{onorato_route_2015,
	title = {Route to thermalization in the $\alpha$-{Fermi}{\textendash}{Pasta}{\textendash}{Ulam} system},
	issn = {0027-8424, 1091-6490},
	url = {http://www.pnas.org/content/early/2015/03/23/1404397112},
	doi = {10.1073/pnas.1404397112},
	abstract = {We study the original $\alpha$-Fermi{\textendash}Pasta{\textendash}Ulam (FPU) system with N = 16, 32, and 64 masses connected by a nonlinear quadratic spring. Our approach is based on resonant wave{\textendash}wave interaction theory; i.e., we assume that, in the weakly nonlinear regime (the one in which Fermi was originally interested), the large time dynamics is ruled by exact resonances. After a detailed analysis of the $\alpha$-FPU equation of motion, we find that the first nontrivial resonances correspond to six-wave interactions. Those are precisely the interactions responsible for the thermalization of the energy in the spectrum. We predict that, for small-amplitude random waves, the timescale of such interactions is extremely large and it is of the order of 1/$\epsilon$8, where $\epsilon$ is the small parameter in the system. The wave{\textendash}wave interaction theory is not based on any threshold: Equipartition is predicted for arbitrary small nonlinearity. Our results are supported by extensive numerical simulations. A key role in our finding is played by the Umklapp (flip-over) resonant interactions, typical of discrete systems. The thermodynamic limit is also briefly discussed.},
	language = {en},
	urldate = {2015-03-25},
	journal = {Proceedings of the National Academy of Sciences},
	author = {Onorato, Miguel and Vozella, Lara and Proment, Davide and Lvov, Yuri V.},
	month = mar,
	year = {2015},
	pages = {201404397},
	file = {Onorato et al-2015-Route to thermalization in the $\alpha$-Fermi{\textendash}Pasta{\textendash}Ulam system.pdf:/Users/lauriej/Box/Zotero_library/2015/Onorato et al-2015-Route to thermalization in the $\alpha$-Fermi{\textendash}Pasta{\textendash}Ulam system.pdf:application/pdf}
}

@article{cheng_leapfrogging_2015,
	title = {Leapfrogging of multiple coaxial viscous vortex rings},
	volume = {27},
	issn = {1070-6631, 1089-7666},
	url = {http://scitation.aip.org/content/aip/journal/pof2/27/3/10.1063/1.4915890},
	doi = {10.1063/1.4915890},
	abstract = {A recent theoretical study [Borisov, Kilin, and Mamaev, {\textquotedblleft}The dynamics of vortex rings: Leapfrogging, choreographies and the stability problem,{\textquotedblright} Regular Chaotic Dyn. 18, 33 (2013); Borisov et al., {\textquotedblleft}The dynamics of vortex rings: Leapfrogging in an ideal and viscous fluid,{\textquotedblright} Fluid Dyn. Res. 46, 031415 (2014)] shows that when three coaxial vortex rings travel in the same direction in an incompressible ideal fluid, each of the vortex rings alternately slips through (or leapfrogs) the other two ahead. Here, we use a lattice Boltzmann method to simulate viscous vortex rings with an identical initial circulation, radius, and separation distance with the aim of studying how viscous effect influences the outcomes of the leapfrogging process. For the case of two identical vortex rings, our computation shows that leapfrogging can be achieved only under certain favorable conditions, which depend on Reynolds number, vortex core size, and initial separation distance between the two rings. For the case of three coaxial vortex rings, the result differs from the inviscid model and shows that the second vortex ring always slips through the leading ring first, followed by the third ring slipping through the other two ahead. A simple physical model is proposed to explain the observed behavior.},
	number = {3},
	urldate = {2015-03-24},
	journal = {Physics of Fluids (1994-present)},
	author = {Cheng, M. and Lou, J. and Lim, T. T.},
	month = mar,
	year = {2015},
	pages = {031702},
	file = {Cheng et al-2015-Leapfrogging of multiple coaxial viscous vortex rings.pdf:/Users/lauriej/Box/Zotero_library/2015/Cheng et al-2015-Leapfrogging of multiple coaxial viscous vortex rings.pdf:application/pdf}
}

