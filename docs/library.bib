@article{doty_maladies_2004,
	title = {Maladies of our souls: identity and voice in the writing of academic international relations},
	volume = {17},
	issn = {0955-7571},
	shorttitle = {Maladies of our souls},
	url = {https://doi.org/10.1080/0955757042000245951},
	doi = {10.1080/0955757042000245951},
	abstract = {Drawing primarily, but not exclusively on the work of Julia Kristeva and Roland Barthes on language, writing, and {\textquoteleft}the subject{\textquoteright}, I examine the issue of identity and writing in international relations. I argue that what has come to be labeled {\textquoteleft}critical{\textquoteright} or {\textquoteleft}radical{\textquoteright} constructivism rather insistently points in the direction of opening up spaces for discussing our own writing and exploring our own voices in what we write, though this has not been actively pursued. Sociologist Avery Gordon uses the phrase {\textquoteleft}making common cause{\textquoteright} to argue that our encounters with the social world {\textquoteleft}must strive to go beyond the fundamental alienation of turning social relations into just things we know and toward our own reckoning with how we are in these stories, with how they change us{\textquoteright}. It seems to me that this is not possible without giving attention to the issue of voice, specifically the voice we use when we write about international relations. To speak of voice is to raise many interesting and important questions, to ponder our use of language, our locations within our stories and the discourses we create, and perhaps most importantly to give recognition to the presence of desire in language and in the writing of international national relations.},
	number = {2},
	urldate = {2019-03-09},
	journal = {Cambridge Review of International Affairs},
	author = {Doty, Roxanne Lynn},
	month = jul,
	year = {2004},
	pages = {377--392},
	file = {Doty-2004-Maladies of our souls.pdf:/Users/lauriej/Box/Zotero_library/2004/Doty-2004-Maladies of our souls.pdf:application/pdf;Snapshot:/Users/lauriej/Zotero/storage/5QE9IG2D/0955757042000245951.html:text/html}
}

