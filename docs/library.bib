@article{roberts_vortex_2003,
	title = {On vortex waves in compressible fluids. {I}. {The} hollow{\textendash}core vortex},
	volume = {459},
	issn = {1364-5021, 1471-2946},
	url = {http://rspa.royalsocietypublishing.org/content/459/2030/331},
	doi = {10.1098/rspa.2002.1034},
	abstract = {In 1880, Kelvin published his analysis of small{\textendash}amplitude waves carried by a straightline vortex in an incompressible, inviscid fluid. The most significant of these waves are the {\textquoteleft}bending modes{\textquoteright}, in which the axis of the vortex becomes helical. The corresponding angular wavenumber, m, is 1, but Kelvin found solutions for all m and all axial wavenumbers k. For the hollow{\textendash}core vortex, the model also studied here, he found two modes for each k and m. For ka << 1, where a is the core radius, the waves are of two types. The majority are {\textquoteleft}fast{\textquoteright}, with frequencies $\omega$ of the order of $\kappa$/a 2, where $\kappa$ is the vortex circulation. The axisymmetric (m = 0) modes and one bending mode are {\textquoteleft}slow{\textquoteright}; for these, $\omega$ is of the order of $\kappa$k 2, apart from a logarithmic factor.
The effects of compressibility on Kelvin7apos;s results are studied here. It is found that $\omega$ for the fast waves may be complex. Such {\textquoteleft}free modes{\textquoteright} radiate sound away from the vortex. For waves of sufficiently short wavelength, $\omega$ is, as in Kelvin's case, real; these may be considered to be {\textquoteleft}bound states{\textquoteright}. The borderline between the free and bound modes is analysed and additional compressive modes are located. It is shown that the slow free modes are weakly unstable.},
	language = {en},
	number = {2030},
	urldate = {2015-09-29},
	journal = {Proceedings of the Royal Society of London A: Mathematical, Physical and Engineering Sciences},
	author = {Roberts, Paul H.},
	month = feb,
	year = {2003},
	pages = {331--352},
	file = {Roberts-2003-On vortex waves in compressible fluids.pdf:/Users/lauriej/Box/Zotero_library/2003/Roberts-2003-On vortex waves in compressible fluids.pdf:application/pdf}
}

@article{roberts_vortex_2003-1,
	title = {On vortex waves in compressible fluids. {II}. {The} condensate vortex},
	volume = {459},
	issn = {1364-5021, 1471-2946},
	url = {http://rspa.royalsocietypublishing.org/content/459/2031/597},
	doi = {10.1098/rspa.2002.1033},
	abstract = {Low-density condensates are often modelled by the Gross-Pitaevskii equation, which is a nonlinear Schr{\"o}dinger equation determining the one-particle wave function,$\psi$. Its solution can be interpreted hydrodynamically in terms of a compressible fluid of density $\rho$, given by the squared amplitude of psi;, moving irrotationally with a velocity that is the gradient of a potential $\phi$ given by the argument of psi;. Since$\psi$ is single valued, $\phi$ is arbitrary to an arbitrary additive multiple of 2?. The circulation round a vortex line, i.e. round a curve on which psi; ={\textless}$\rho$ =0, is, therefore, quantized in units of$\kappa$ =h/M, where M is the particle mass and h is Planck's constant. This paper analyses waves of infinitesimal amplitude travelling on a singly quantized rectilinear vortex. It is therefore a sequel to the previous paper in this series in which Kelvin waves on a hollow-core vortex in a compressible Euler fluid were investigated. In both situations, the waves may be bound or free, depending on their angular and axial wavenumbers, m and k. The free waves radiate energy acoustically to infinity, while the bound states do not. It is found that one class of m =1 modes, called{\textquoteleft}slow modes{\textquoteright}because of their low frequency, consists of bound states for all k. The slow m =2 modes are also bound when k is sufficiently large, but are free for small k.},
	language = {en},
	number = {2031},
	urldate = {2015-09-29},
	journal = {Proceedings of the Royal Society of London A: Mathematical, Physical and Engineering Sciences},
	author = {Roberts, Paul H.},
	month = mar,
	year = {2003},
	pages = {597--607},
	file = {Roberts-2003-On vortex waves in compressible fluids.pdf:/Users/lauriej/Box/Zotero_library/2003/Roberts-2003-On vortex waves in compressible fluids.pdf:application/pdf}
}

@article{pointin_statistical_1976,
	title = {Statistical mechanics of two-dimensional vortices in a bounded container},
	volume = {19},
	issn = {0031-9171},
	url = {http://scitation.aip.org/content/aip/journal/pof1/19/10/10.1063/1.861347},
	doi = {10.1063/1.861347},
	abstract = {The equilibrium statistics of a large number of two-dimensional point vortices of arbitrary sign, evolving in an arbitrary domain closed by a bounded curve, are investigated in the microcanonical formulation. The resulting differential equations for the spatial distribution function of the vortices are numerically integrated in various cases and the associated thermodynamic functions are computed. The case of a globally neutral, spatially uniform distribution is particularly studied for its connections with two-dimensional turbulence and the use of the random phase approximation. Some numerical simulations of vortex motion in a circular domain support the theoretical development.},
	number = {10},
	urldate = {2015-09-28},
	journal = {Physics of Fluids (1958-1988)},
	author = {Pointin, Y. B. and Lundgren, T. S.},
	month = oct,
	year = {1976},
