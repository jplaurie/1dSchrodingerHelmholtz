}

@article{burgess_kraichnanleithbatchelor_2015,
	title = {Kraichnan{\textendash}{Leith}{\textendash}{Batchelor} similarity theory and two-dimensional inverse cascades},
	volume = {767},
	issn = {1469-7645},
	url = {http://journals.cambridge.org/article_S0022112015000269},
	doi = {10.1017/jfm.2015.26},
	abstract = {We study the scaling properties and Kraichnan{\textendash}Leith{\textendash}Batchelor (KLB) theory of forced inverse cascades in generalized two-dimensional (2D) fluids ( \${\i}t{\textbackslash}alpha$^{\textrm{2\$}}$ . We consider \${\i}t{\textbackslash}alpha=1\$ (surface quasigeostrophic flow), \${\i}t{\textbackslash}alpha=2\$ (2D Euler flow) and \${\i}t{\textbackslash}alpha=3\$ . The forcing scale is well resolved, a direct cascade is present and there is no large-scale dissipation. Coherent vortices spanning a range of sizes, most larger than the forcing scale, are present for both \${\i}t{\textbackslash}alpha=1\$ and \${\i}t{\textbackslash}alpha=2\$ . The active scalar field for \${\i}t{\textbackslash}alpha=3\$ contains comparatively few and small vortices. The energy spectral slopes in the inverse cascade are steeper than the KLB prediction \$-(7-{\i}t{\textbackslash}alpha)/3\$ in all three systems. Since we stop the simulations well before the cascades have reached the domain scale, vortex formation and spectral steepening are not due to condensation effects; nor are they caused by large-scale dissipation, which is absent. One- and two-point p.d.f.s, hyperflatness factors and structure functions indicate that the inverse cascades are intermittent and non-Gaussian over much of the inertial range for \${\i}t{\textbackslash}alpha=1\$ and \${\i}t{\textbackslash}alpha=2\$ , while the \${\i}t{\textbackslash}alpha=3\$ inverse cascade is much closer to Gaussian and non-intermittent. For \${\i}t{\textbackslash}alpha=3\$ the steep spectrum is close to that associated with enstrophy equipartition. Continuous wavelet analysis shows approximate KLB scaling \${\textbackslash}mathscrE(k){\textbackslash}propto k{\textasciicircum}-2 ({\i}t{\textbackslash}alpha=1)\$ and \${\textbackslash}mathscrE(k){\textbackslash}propto k{\textasciicircum}-5/3 ({\i}t{\textbackslash}alpha=2)\$ in the interstitial regions between the coherent vortices. Our results demonstrate that coherent vortex formation ( \${\i}t{\textbackslash}alpha=1\$ and \${\i}t{\textbackslash}alpha=2\$ ) and non-realizability ( \${\i}t{\textbackslash}alpha=3\$ ) cause 2D inverse cascades to deviate from the KLB predictions, but that the flow between the vortices exhibits KLB scaling and non-intermittent statistics for \${\i}t{\textbackslash}alpha=1\$ and \${\i}t{\textbackslash}alpha=2\$ .},
	urldate = {2015-03-09},
	journal = {Journal of Fluid Mechanics},
	author = {Burgess, B. H. and Scott, R. K. and Shepherd, T. G.},
	month = mar,
	year = {2015},
	pages = {467--496},
	file = {Burgess et al-2015-Kraichnan{\textendash}Leith{\textendash}Batchelor similarity theory and two-dimensional inverse cascades.pdf:/Users/lauriej/Box/Zotero_library/2015/Burgess et al-2015-Kraichnan{\textendash}Leith{\textendash}Batchelor similarity theory and two-dimensional inverse cascades.pdf:application/pdf}
}

