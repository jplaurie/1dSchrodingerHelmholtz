}

@article{falkovich_single_2013,
	title = {Single {Flow} {Snapshot} {Reveals} the {Future} and the {Past} of {Pairs} of {Particles} in {Turbulence}},
	volume = {110},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.110.214502},
	doi = {10.1103/PhysRevLett.110.214502},
	abstract = {We develop an analytic formalism and derive new exact relations that express the short-time dispersion of fluid particles via the single-time velocity correlation functions in homogeneous isotropic and incompressible turbulence. The formalism establishes a bridge between single-time Eulerian and long-time Lagrangian pictures of turbulent flows. In particular, we derive an exact formula for a short-term counterpart of the long-time Richardson law, and we identify a conservation law of turbulent dispersion which is true even in nonstationary turbulence.},
	number = {21},
	urldate = {2014-07-03},
	journal = {Physical Review Letters},
	author = {Falkovich, Gregory and Frishman, Anna},
