}

@article{kozik_scale-separation_2005,
	title = {Scale-{Separation} {Scheme} for {Simulating} {Superfluid} {Turbulence}: {Kelvin}-{Wave} {Cascade}},
	volume = {94},
	shorttitle = {Scale-{Separation} {Scheme} for {Simulating} {Superfluid} {Turbulence}},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.94.025301},
	doi = {10.1103/PhysRevLett.94.025301},
	abstract = {A Kolmogorov-type cascade of Kelvin waves{\textemdash}the distortion waves on vortex lines{\textemdash}plays a key part in the relaxation of superfluid turbulence at low temperatures. We propose an efficient numeric scheme for simulating the Kelvin-wave cascade on a single vortex line. This idea is likely to be generalizable for a full-scale simulation of different regimes of superfluid turbulence. With the new scheme, we are able to unambiguously resolve the cascade spectrum exponent, and thus to settle the controversy between recent simulations of Vinen, Tsubota, and Mitani [Phys. Rev. Lett. 91, 135301 (2003)] and recently developed analytic theory [Phys. Rev. Lett. 92, 035301 (2004)].},
	number = {2},
	urldate = {2014-08-20},
