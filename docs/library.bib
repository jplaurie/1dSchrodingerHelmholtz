@article{bardoczi_experimental_2014,
	title = {Experimental confirmation of self-regulating turbulence paradigm in two-dimensional spectral condensation},
	volume = {90},
	url = {http://link.aps.org/doi/10.1103/PhysRevE.90.063103},
