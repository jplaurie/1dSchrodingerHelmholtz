	year = {2014},
	pages = {114--154},
	file = {Galtier-2014-Weak turbulence theory for rotating magnetohydrodynamics and planetary flows.pdf:/Users/lauriej/Box/Zotero_library/2014/Galtier-2014-Weak turbulence theory for rotating magnetohydrodynamics and planetary flows.pdf:application/pdf}
