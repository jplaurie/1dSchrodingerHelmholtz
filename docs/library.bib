	pages = {034801},
	file = {APS Snapshot:/Users/lauriej/Zotero/storage/KHA75HBW/PhysRevFluids.4.html:text/html;Full Text PDF:/Users/lauriej/Zotero/storage/VMMBGCCC/Brunet et al. - 2019 - Linear and nonlinear regimes of an inertial wave a.pdf:application/pdf}
}

