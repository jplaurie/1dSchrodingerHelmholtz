@article{debbasch_what_2004,
	title = {What is a mean gravitational field?},
	volume = {37},
	issn = {1434-6028, 1434-6036},
	url = {https://link.springer.com/article/10.1140/epjb/e2004-00053-9},
	doi = {10.1140/epjb/e2004-00053-9},
	abstract = {The equations of General Relativity are non-linear. This makes their averaging non-trivial. The notion of mean gravitational field is defined and it is proven that this field obeys the equations of General Relativity if the unaveraged field does. The workings of the averaging procedure on Maxwell{\textquoteright}s field and on perfect fluids in curved space-times are also discussed. It is found that Maxwell{\textquoteright}s equations are still verified by the averaged quantities but that the equation of state for other kinds of matter generally changes upon average. In particular, it is proven that the separation between matter and gravitational field is not scale-independent. The same result can be interpreted by introducing a stress-energy tensor for a mean-vacuum. Possible applications to cosmology are discussed. Finally, the work presented in this article also suggests that the signature of the metric might be scale-dependent too.},
	language = {en},
	number = {2},
	urldate = {2018-06-22},
	journal = {The European Physical Journal B - Condensed Matter and Complex Systems},
	author = {Debbasch, F.},
	month = jan,
	year = {2004},
	pages = {257--269},
	file = {Debbasch-2004-What is a mean gravitational field.pdf:/Users/lauriej/Box/Zotero_library/2004/Debbasch-2004-What is a mean gravitational field.pdf:application/pdf;Snapshot:/Users/lauriej/Zotero/storage/HMIWL3YV/e2004-00053-9.html:text/html}
}

