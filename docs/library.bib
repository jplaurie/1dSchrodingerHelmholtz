@article{hayot_multifractality_1996,
	title = {Multifractality in the stochastic {Burgers} equation},
	volume = {54},
	url = {http://link.aps.org/doi/10.1103/PhysRevE.54.4681},
	doi = {10.1103/PhysRevE.54.4681},
	abstract = {We investigate numerically the scaling properties of spatiotemporal correlation functions in the one-dimensional Burgers equation driven by noise with variance proportional to {\textbar}k{\textbar}$\beta$. The long-distance behavior at $\beta${\textless}0 is determined by shocks that lead to multifractality in the high-order structure functions and a dynamical exponent z close to unity. For $\beta${\textgreater}0 earlier theoretical predictions for scaling exponents constrained by Galilean invariance obtain; these results are not expected to hold for $\beta${\textless}0. Nevertheless, the continuation of the fixed point to $\beta${\textless}0 correctly predicts some of the properties, an occurrence that we relate to the anomalous scaling of composite operators. {\textcopyright} 1996 The American Physical Society.},
