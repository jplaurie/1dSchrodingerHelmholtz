@article{cerjan_finding_1981,
	title = {On finding transition states},
	volume = {75},
	issn = {0021-9606, 1089-7690},
	url = {http://scitation.aip.org/content/aip/journal/jcp/75/6/10.1063/1.442352},
	doi = {10.1063/1.442352},
	abstract = {An algorithm for locating transition states on a potential energy surface is described. The most important feature of the algorithm, which makes explicit use of the second derivative matrix of the potential surface, is that it is able to {\textquoteright}{\textquoteright}walk uphill{\textquoteright}{\textquoteright} from the minimum on a potential surface to the transition state essentially automatically. The method is illustrated by application to a two dimensional model problem, to the vinylidene{\textendash}acetylene rearrangement (H2C = C:<->HC=CH), and to the dissociation and rearrangement of formaldehyde (H2CO<->H2+CO, HCOH). The algorithm is also seen to provide an improved way of following a reaction path from a transition state down to reactants or products.},
