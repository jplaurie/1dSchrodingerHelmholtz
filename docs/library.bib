	pages = {515--536},
	file = {Caroli et al-1980-A WKB treatment of diffusion in a multidimensional bistable potential.pdf:/Users/lauriej/Box/Zotero_library/1980/Caroli et al-1980-A WKB treatment of diffusion in a multidimensional bistable potential.pdf:application/pdf}
}

