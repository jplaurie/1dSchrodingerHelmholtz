@article{randoux_intermittency_2014,
	title = {Intermittency in {Integrable} {Turbulence}},
	volume = {113},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.113.113902},
	doi = {10.1103/PhysRevLett.113.113902},
	abstract = {We examine the statistical properties of nonlinear random waves that are ruled by the one-dimensional defocusing and integrable nonlinear Schr{\"o}dinger equation. Using fast detection techniques in an optical fiber experiment, we observe that the probability density function of light fluctuations is characterized by tails that are lower than those predicted by a Gaussian distribution. Moreover, by applying a bandpass frequency optical filter, we reveal the phenomenon of intermittency; i.e., small scales are characterized by large heavy-tailed deviations from Gaussian statistics, while the large ones are almost Gaussian. These phenomena are very well described by numerical simulations of the one-dimensional nonlinear Schr{\"o}dinger equation.},
	number = {11},
	urldate = {2018-01-11},
